def _locate_web_host_launcher() -> Path | None:
    """Locate serve-web.py for either a Navigator checkout or a packaged install."""

    candidates = [
        WORKSPACE_ROOT / "scripts" / "serve-web.py",
        CYRENE_ROOT / "Cyrene-Navigator" / "scripts" / "serve-web.py",
        CYRENE_ROOT / "Cyrene-Services" / "Cyrene-Navigator" / "scripts" / "serve-web.py",
        Path("/usr/lib/cyrene/scripts/serve-web.py"),
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def _running_under_systemd() -> bool:
    """True when systemd itself invoked this process (i.e. from a unit)."""

    return bool(os.environ.get("INVOCATION_ID") or os.environ.get("JOURNAL_STREAM"))


def _start_units_with_systemd() -> bool:
    """Start the packaged Product units when systemd actually owns them."""

    if not Path("/run/systemd/system").exists() or shutil.which("systemctl") is None:
        return False
    probe = subprocess.run(
        ["systemctl", "list-unit-files", *[f"{unit}.service" for unit in SYSTEMD_UNITS]],
        capture_output=True,
        text=True,
        check=False,
    )
    if probe.returncode != 0:
        return False
    installed = [unit for unit in SYSTEMD_UNITS if f"{unit}.service" in probe.stdout]
    if not installed:
        return False
    started = subprocess.run(["systemctl", "start", *installed], check=False)
    if started.returncode != 0:
        return False
    print(f"Started {len(installed)} Cyrene unit(s) via systemd.")
    return True


def _web_host_command(launcher: Path) -> list[str]:
    """Prefer the project's uv environment; fall back to this interpreter.

    The Web Host needs its own dependencies, which `python3` alone usually does
    not have. A packaged install keeps them under /usr/lib/cyrene, so the same
    rule works for both layouts.
    """

    project_root = launcher.parent.parent
    if (project_root / "pyproject.toml").is_file() and shutil.which("uv") is not None:
        return ["uv", "run", "--project", str(project_root), "python", str(launcher)]
    return [sys.executable, str(launcher)]


def _start_web_host(home: Path, env: dict[str, str], pair_code: str) -> int | None:
    """Start the Web Host detached so `cyrene up` does not hold the terminal."""

    launcher = _locate_web_host_launcher()
    if launcher is None:
        print("[WARN] Navigator Web Host launcher (serve-web.py) was not found.")
        print("       Products are up but the console API is unreachable.")
        return None

    logs_dir = home / "logs"
    logs_dir.mkdir(parents=True, exist_ok=True)
    argv = [
        *_web_host_command(launcher),
        "--host",
        os.environ.get("CYRENE_WEB_HOST_HOST", "127.0.0.1"),
        "--port",
        str(WEB_HOST_PORT),
        "--pairing-code",
        pair_code,
    ]
    for product, port in PRODUCT_PORTS.items():
        argv += ["--proxy", f"/api/v1/{product}=http://127.0.0.1:{port}"]
    # A same-host HTTP console cannot set Secure cookies; suppress only that.
    argv.append("--insecure-http")

    try:
        log_handle = (logs_dir / "navigator-web-host.log").open("ab")
        try:
            process = subprocess.Popen(
                argv,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        finally:
            log_handle.close()
    except OSError as error:
        print(f"[WARN] Could not start Navigator Web Host: {error}")
        return None
    return process.pid


def _navigator_web_host_invocation() -> tuple[list[str], dict[str, str]] | None:
    """Prepare the foreground Navigator Web Host command for its own unit.

    The returned command starts only the Web Host. It deliberately does not
    delegate to ``cyrene up`` or the development stack, which systemd owns as
    separate service units.
    """

    home = dev_home()
    prepare_data_dirs(home)
    pair_code, issued_at = read_pair_credentials(home)
    if not pair_code:
        pair_code = generate_pair_code()
        write_credentials(home, pair_code)
        _, issued_at = read_pair_credentials(home)

    launcher = _locate_web_host_launcher()
    if launcher is None:
        print("ERROR: Navigator Web Host launcher (serve-web.py) was not found.", file=sys.stderr)
        return None

    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)
    env["CYRENE_WEB_HOST_PAIR_CODE"] = pair_code
    if issued_at:
        env["CYRENE_WEB_HOST_PAIR_CODE_ISSUED_AT"] = issued_at

    argv = [
        *_web_host_command(launcher),
        "--host",
        os.environ.get("CYRENE_WEB_HOST_HOST", "127.0.0.1"),
        "--port",
        str(WEB_HOST_PORT),
        "--pairing-code",
        pair_code,
    ]
    for product, port in PRODUCT_PORTS.items():
        argv += ["--proxy", f"/api/v1/{product}=http://127.0.0.1:{port}"]
    argv.append("--insecure-http")
    return argv, env


def cmd_up(args: argparse.Namespace) -> int:
    home = dev_home()
    prepare_data_dirs(home)
    pair_code, issued_at = read_pair_credentials(home)
    if not pair_code:
        pair_code = generate_pair_code()
        write_credentials(home, pair_code)
        _, issued_at = read_pair_credentials(home)

    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)
    env["CYRENE_WEB_HOST_PAIR_CODE"] = pair_code
    if issued_at:
        env["CYRENE_WEB_HOST_PAIR_CODE_ISSUED_AT"] = issued_at

    # A manual packaged start delegates to the installed service units. A unit
    # itself must keep foreground ownership and never recursively call systemctl.
    if not _running_under_systemd() and _start_units_with_systemd():
        print(f"Navigator console ready: http://127.0.0.1:{WEB_HOST_PORT}")
        return 0

    cmd = [sys.executable, str(DEV_SCRIPT), "up"]
    if getattr(args, "no_build", False):
        cmd.append("--no-build")
    returncode = subprocess.run(cmd, env=env, check=False).returncode
    if returncode != 0:
        return returncode

    pid = _start_web_host(home, env, pair_code)
    if pid is None:
        return 0
    print(f"Navigator console ready: http://127.0.0.1:{WEB_HOST_PORT}")
    print(_pair_code_notice(home, pair_code))
    print(f"Web Host PID {pid}; see {home / 'logs' / 'navigator-web-host.log'} for its output.")
    return 0


def cmd_service_run(args: argparse.Namespace) -> int:
    """Run exactly one packaged service in the foreground for systemd."""

    service = args.service
    packaged = WORKSPACE_ROOT == Path("/usr/lib/cyrene")
    bundle_module: Any | None = None
    try:
        bundle_module = _load_service_bundle_module()
    except FileNotFoundError as error:
        if packaged:
            print(f"ERROR: cannot load packaged service release metadata: {error}", file=sys.stderr)
            return 1
    except (ImportError, OSError, RuntimeError, ValueError) as error:
        print(f"ERROR: cannot resolve the installed {service} release: {error}", file=sys.stderr)
        return 1

    release = None
    if bundle_module is not None:
        try:
            if _service_update_journal_exists(bundle_module, service) and not (
                _service_update_in_progress(service)
            ):
                print(
                    f"ERROR: {service} has an interrupted legacy release update; refusing to launch "
                    "until an administrator completes the verified maintenance-gate recovery.",
                    file=sys.stderr,
                )
                return 1
            service_root = service_install_root() / "services" / service
            if service_root.exists() or service_root.is_symlink():
                release = bundle_module.resolve_active_release(
                    service, install_root=service_install_root()
                )
        except (ImportError, OSError, RuntimeError, ValueError) as error:
            print(
                f"ERROR: cannot resolve the installed {service} release: {error}", file=sys.stderr
            )
            return 1

    service_args = list(args.service_args)
    if release is not None:
        entrypoint, version = release
        print(f"Starting {service} release {version}.", flush=True)
        try:
            os.execv(str(entrypoint), [str(entrypoint), *service_args])
        except OSError as error:
            print(f"ERROR: cannot execute {service} release {version}: {error}", file=sys.stderr)
            return 1

    if packaged:
        print(
            f"ERROR: packaged {service} has no active immutable release; "
            "refusing to launch a mutable system-Python fallback.",
            file=sys.stderr,
        )
        return 1

    # Development-mode units may keep their historical module entrypoints.
    # The packaged mode above fails closed because these installs have no
    # immutable release identity that the updater could restore.
    if service == "navigator":
        invocation = _navigator_web_host_invocation()
        if invocation is None:
            return 1
        argv, env = invocation
        try:
            os.execvpe(argv[0], argv, env)
        except OSError as error:
            print(f"ERROR: cannot start Navigator Web Host: {error}", file=sys.stderr)
            return 1

    command = LEGACY_SERVICE_COMMANDS.get(service)
    if command is None:
        print(f"ERROR: no launch command is registered for {service}.", file=sys.stderr)
        return 2
    try:
        os.execv(command[0], [*command, *service_args])
    except OSError as error:
        print(f"ERROR: cannot start {service}: {error}", file=sys.stderr)
        return 1
    return 0


def cmd_service_bootstrap(args: argparse.Namespace) -> int:
    """Stage package-provided immutable releases during Debian installation."""

    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        print("ERROR: service release bootstrap must run as root.", file=sys.stderr)
        return 1
    if WORKSPACE_ROOT == Path("/usr/lib/cyrene"):
        fixed_roots = {
            "CYRENE_INSTALL_ROOT": Path("/usr/lib/cyrene"),
            "CYRENE_SERVICE_ARTIFACTS_ROOT": Path("/usr/share/cyrene/service-artifacts"),
        }
        for variable, fixed_root in fixed_roots.items():
            configured = os.environ.get(variable)
            if configured and Path(configured).expanduser().resolve() != fixed_root:
                print(
                    f"ERROR: packaged bootstrap does not accept a custom {variable}.",
                    file=sys.stderr,
                )
                return 1
    try:
        bundle_module = _load_service_bundle_module()
        interrupted = [
            service
            for service in SYSTEMD_SERVICES
            if _service_update_journal_exists(bundle_module, service)
        ]
        if interrupted:
            raise RuntimeError(
                "interrupted service update journal(s) require recovery before package "
                f"configuration: {', '.join(interrupted)}"
            )
        staged = bundle_module.bootstrap_package_bundles(
            activate_missing=bool(args.activate_missing)
        )
    except (ImportError, OSError, RuntimeError, ValueError) as error:
        print(f"ERROR: could not stage packaged service releases: {error}", file=sys.stderr)
        return 1
    print(f"Staged {staged} immutable service release(s).")
    return 0


def cmd_down(args: argparse.Namespace) -> int:
    loaded_units = _loaded_systemd_units()
    if loaded_units:
        result = subprocess.run(
            ["systemctl", "stop", *loaded_units], capture_output=True, text=True, check=False
        )
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip()
            print(
                f"Could not stop managed Cyrene unit(s): {detail or result.returncode}",
                file=sys.stderr,
            )
            return result.returncode or 1
        print(f"Stopped {len(loaded_units)} managed Cyrene systemd unit(s).")
        return 0

    home = dev_home()
    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)
    return subprocess.run(
        [sys.executable, str(DEV_SCRIPT), "down"], env=env, check=False
    ).returncode


def get_gpu_info() -> list[dict[str, str]]:
    try:
        out = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=name,memory.total,memory.used,utilization.gpu",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        if out.returncode != 0 or not out.stdout.strip():
            return []
        gpus = []
        for line in out.stdout.strip().splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 4:
                gpus.append(
                    {
                        "name": parts[0],
                        "memory_total": parts[1],
                        "memory_used": parts[2],
                        "utilization": parts[3],
                    }
                )
        return gpus
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return []


def cmd_status(args: argparse.Namespace) -> int:
    loaded_units = _loaded_systemd_units()
    if loaded_units:
        print("=== Cyrene Managed systemd Services ===")
        try:
            bundle_module = _load_service_bundle_module()
        except (ImportError, OSError, RuntimeError, ValueError) as error:
            bundle_module = None
            print(f"Release metadata unavailable: {error}")
        for service in SYSTEMD_SERVICES:
            unit = f"cyrene-{service}.service"
            unit_state = _systemd_unit_state(unit)
            if unit_state is None:
                print(f"  {service}: unit status unavailable")
            else:
                load_state, active_state, sub_state = unit_state
                print(f"  {service}: {load_state}, {active_state}/{sub_state}")
            if bundle_module is not None:
                try:
                    if _service_update_journal_exists(bundle_module, service):
                        print(
                            "    update: INTERRUPTED LEGACY TRANSACTION; service launch remains fail-closed"
                        )
                        continue
                    release = bundle_module.resolve_active_release(
                        service, install_root=service_install_root()
                    )
                except (OSError, RuntimeError, ValueError) as error:
                    print(f"    release: INVALID ({error})")
                else:
                    if release is None:
                        print("    release: unsupported (no active immutable artifact)")
                    else:
                        print(f"    release: {release[1]}")
        print("  echo: unmanaged by the native Debian systemd path")
        print("\n=== GPU Information ===")
        _print_gpu_status()
        return 0

    home = dev_home()
    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)

    print("=== Cyrene Services Status ===")
    dev_res = subprocess.run(
        [sys.executable, str(DEV_SCRIPT), "status"], env=env, check=False
    ).returncode

    print("\n=== GPU Information ===")
    _print_gpu_status()
    return dev_res


def _print_gpu_status() -> None:
    """Print host GPU status for both packaged and development operations."""

    gpus = get_gpu_info()
    if not gpus:
        print("No GPU detected or nvidia-smi unavailable.")
    else:
        for i, g in enumerate(gpus):
            print(
                f"GPU {i}: {g['name']} | "
                f"Memory: {g['memory_used']} / {g['memory_total']} MiB | "
                f"Utilization: {g['utilization']}%"
            )


def check_port_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def python_module_version(module_name: str) -> str | None:
    """Installed version of `module_name`, or None when it is not importable.

    Probing the current interpreter is deliberate: `cmd_up` launches Products
    through `sys.executable`, so a package missing here is missing for them too.
    """
    if importlib.util.find_spec(module_name) is None:
        return None
    try:
        return importlib.metadata.version(module_name)
    except importlib.metadata.PackageNotFoundError:
        return "present (version metadata unavailable)"


def git_head(repo_path: Path) -> str | None:
    """Current HEAD revision of a checkout, or None when it cannot be read."""
    try:
        out = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.strip() or None


def cmd_doctor(args: argparse.Namespace) -> int:
    home = dev_home()
    all_passed = True
    print("┌─────────────────────────────────────────────────────────────┐")
    print("│                 Cyrene Environment Preflight                │")
    print("└─────────────────────────────────────────────────────────────┘")

    # 1. Python version >= 3.11
    py_ver = sys.version_info
    py_str = f"{py_ver.major}.{py_ver.minor}.{py_ver.micro}"
    if py_ver >= (3, 11):
        print(f"[OK] Python version: {py_str} (>= 3.11)")
    else:
        print(f"[FAIL] Python version: {py_str} (must be >= 3.11)")
        all_passed = False

    # 2. nvidia-smi & GPU VRAM
    gpus = get_gpu_info()
    if not gpus:
        print("[FAIL] NVIDIA driver: nvidia-smi failed or no GPU found")
        all_passed = False
    else:
        total_vram_mib = 0
        has_12g = False
        for g in gpus:
            try:
                vram = float(g["memory_total"])
                total_vram_mib += vram
                if vram >= 12000 or round(vram / 1024) >= 12:  # Nominal 12 GiB
                    has_12g = True
            except ValueError:
                pass
        if has_12g:
            print(f"[OK] GPU: {len(gpus)} detected, with >= 12 GiB VRAM ({gpus[0]['name']})")
        else:
            print(
                f"[FAIL] GPU: {len(gpus)} detected, but requires at least 1 GPU with >= 12 GiB VRAM"
            )
            all_passed = False

    # 3. CUDA check
    cuda_found = False
    cuda_ver = "unknown"
    try:
        out = subprocess.run(
            ["nvcc", "--version"],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        if out.returncode == 0:
            cuda_found = True
            for line in out.stdout.splitlines():
                if "release" in line:
                    cuda_ver = line.strip()
    except (FileNotFoundError, OSError):
        pass
    if not cuda_found:
        if Path("/usr/local/cuda").exists():
            cuda_found = True
            cuda_ver = "installed at /usr/local/cuda"
        elif gpus:
            cuda_found = True
            cuda_ver = "CUDA driver available via nvidia-smi"
    if cuda_found:
        print(f"[OK] CUDA: Available ({cuda_ver})")
    else:
        print("[WARN] CUDA: nvcc / CUDA toolkit not found in standard paths")

    # 4. Free disk >= 50 GiB
    try:
        usage = shutil.disk_usage(home if home.exists() else "/")
        free_gib = usage.free / (1024**3)
        if free_gib >= 50.0:
            print(f"[OK] Disk space: {free_gib:.1f} GiB free (>= 50 GiB required)")
        else:
            print(f"[FAIL] Disk space: {free_gib:.1f} GiB free (requires >= 50 GiB)")
            all_passed = False
    except OSError as e:
        print(f"[FAIL] Disk space check failed: {e}")
        all_passed = False

    # 5. Training and serving engines.
    # These used to be assumed present, so doctor reported a clean bill of
    # health on hosts that could neither train nor serve. They must be
    # resolvable to a version because release-lock.json pins exact ones.
    for module, purpose in REQUIRED_PYTHON_MODULES.items():
        version = python_module_version(module)
        if version is None:
            print(f"[FAIL] {module}: not installed — {purpose}")
            all_passed = False
        else:
            print(f"[OK] {module}: {version}")

    # 6. release-lock.json pins vs the revisions actually checked out.
    # A mismatch only warns: it means you are running a different revision than
    # the RC declares, which is legitimate during development but must not be
    # silent when shipping acceptance evidence.
    lock_path = WORKSPACE_ROOT / "release-lock.json"
    try:
        lock = json.loads(lock_path.read_text(encoding="utf-8"))
        pinned_repositories = lock.get("repositories", {})
        if not pinned_repositories:
            print("[WARN] release-lock.json declares no 'repositories' pins to verify")
        else:
            checked_out = 0
            mismatched = 0
            for repo, expected in sorted(pinned_repositories.items()):
                repo_path = CYRENE_ROOT / repo
                # A developer checkout is usually partial; absent repos are
                # reported as skipped rather than as a mismatch.
                if not (repo_path / ".git").exists():
                    continue
                checked_out += 1
                actual = git_head(repo_path)
                if actual is None:
                    print(f"[WARN] Lock SHA unreadable: {repo} (cannot read git HEAD)")
                elif actual != expected:
                    mismatched += 1
                    print(
                        f"[WARN] Lock SHA mismatch: {repo} "
                        f"(lock: {expected[:8]}, current: {actual[:8]})"
                    )
            if checked_out == 0:
                print("[SKIP] Lock SHA: no pinned repositories are checked out locally")
            elif mismatched == 0:
                noun = "repository" if checked_out == 1 else "repositories"
                print(f"[OK] Lock SHA: {checked_out} checked-out {noun} match release-lock.json")
    except FileNotFoundError:
        print(f"[WARN] release-lock.json not found at {lock_path}")
    except (OSError, json.JSONDecodeError) as e:
        print(f"[WARN] release-lock.json could not be verified: {e}")

    # 7. systemd or proc available
    has_systemd_or_proc = (
        Path("/run/systemd/system").exists()
        or Path("/proc").exists()
        or shutil.which("systemctl") is not None
    )
    if has_systemd_or_proc:
        print("[OK] Process supervisor: Linux /proc or systemd available")
    else:
        print("[FAIL] Neither systemd nor /proc is available")
        all_passed = False

    # 8. Check required ports
    for label, port in DEFAULT_PORTS.items():
        if check_port_free(port):
            print(f"[OK] Port {label}: available")
        else:
            print(f"[WARN] Port {label}: occupied or in use")

    # 9. Check Product services health if running
    pids_file = home / "pids.json"
    if pids_file.is_file():
        print("\n--- Running Services Health Check ---")
        try:
            pids = json.loads(pids_file.read_text(encoding="utf-8"))
            for name, pid in pids.items():
                try:
                    os.kill(int(pid), 0)
                    print(f"[OK] Service '{name}' (PID {pid}): process active")
                except ProcessLookupError:
                    print(f"[FAIL] Service '{name}' (PID {pid}): process died")
                    all_passed = False
        except (OSError, json.JSONDecodeError):
            pass

    print("─────────────────────────────────────────────────────────────")
    if all_passed:
        print("Doctor assessment: ALL SYSTEM CHECKS PASSED.")
        return 0
    else:
        print("Doctor assessment: ISSUES FOUND. Resolve blockers before running cyrene up.")
        return 1


def cmd_logs(args: argparse.Namespace) -> int:
    source = _diagnostics_source(args)
    trace_id = getattr(args, "trace", None)
    if source is not None:
        return _logs_from_diagnostics(source, args)
    if trace_id:
        return _scan_trace(trace_id, getattr(args, "lines", 50))

    home = dev_home()
    logs_dir = home / "logs"
    if not logs_dir.is_dir():
        print(f"No logs directory found at {logs_dir}")
        return 1

    service = getattr(args, "service", None)
    if not service:
        print("Available log files in logs directory:")
        for log_file in sorted(logs_dir.glob("*.log")):
            print(f"  - {log_file.name}")
        return 0

    candidates = [
        logs_dir / f"{service}.stdout.log",
        logs_dir / f"{service}.stderr.log",
        logs_dir / f"{service}-control.stdout.log",
        logs_dir / f"{service}-control.stderr.log",
    ]
    target_files = [f for f in candidates if f.is_file()]
    if not target_files:
        matching = list(logs_dir.glob(f"*{service}*.log"))
        target_files = matching

    if not target_files:
        print(f"No log files found for service '{service}' in {logs_dir}")
        return 1

    lines = getattr(args, "lines", 50)
    for tf in target_files:
        print(f"\n=== {tf.name} (last {lines} lines) ===")
        try:
            all_lines = tf.read_text(encoding="utf-8", errors="replace").splitlines()
            for line in all_lines[-lines:]:
                print(line)
        except OSError as e:
            print(f"Error reading {tf}: {e}")

    if getattr(args, "follow", False) and target_files:
        main_target = target_files[0]
        print(f"\n--- Following {main_target.name} (Ctrl+C to stop) ---")
        try:
            with main_target.open("r", encoding="utf-8", errors="replace") as f:
                f.seek(0, os.SEEK_END)
                while True:
                    line = f.readline()
                    if line:
                        sys.stdout.write(line)
                        sys.stdout.flush()
                    else:
                        time.sleep(0.5)
        except KeyboardInterrupt:
            return 0
    return 0


def _logs_from_diagnostics(source: tuple[str, str], args: argparse.Namespace) -> int:
    """Print one resource's diagnostics, optionally following until terminal."""

    kind, url = source
    lines = getattr(args, "lines", 50)
    as_json = bool(getattr(args, "json", False))
    follow = bool(getattr(args, "follow", False))
    cursor = 0
    try:
        while True:
            page = _request_json(f"{url}?afterSequence={cursor}&limit={DIAGNOSTICS_PAGE_LIMIT}")
            cursor = _print_diagnostics_page(page, as_json=as_json, lines=lines)
            if not follow or page.get("terminal"):
                if page.get("diagnostics_degraded") or page.get("diagnosticsDegraded"):
                    print(
                        f"WARNING: {kind} diagnostics are degraded; some output was lost.",
                        file=sys.stderr,
                    )
                break
            lines = 0  # only the first page is tailed; later pages print in full
            time.sleep(0.5)
    except RuntimeError as error:
        print(f"ERROR: {error}")
        return 1
    except KeyboardInterrupt:
        return 0
    return 0


def cmd_diagnostics_collect(args: argparse.Namespace) -> int:
    """Write a redacted diagnostics bundle for one resource to a private file."""

    source = _diagnostics_source(args)
    trace_id = getattr(args, "trace", None)
    output = Path(args.output).expanduser()
    bundle: dict[str, Any] = {
        "generatedAt": datetime.now(UTC).isoformat(),
        "tool": "cyrene",
        "correlation": {},
        "versions": _version_manifest(),
        "diagnostics": [],
        "resource": None,
        "cleanup": {"confirmed": False, "detail": "resource state was not read"},
    }

    exit_code = 0
    if source is not None:
        kind, url = source
        cursor = 0
        items: list[dict[str, Any]] = []
        try:
            while True:
                page = _request_json(f"{url}?afterSequence={cursor}&limit={DIAGNOSTICS_PAGE_LIMIT}")
                items.extend(page.get("items") or [])
                next_cursor = int(page.get("nextSequence") or cursor)
                terminal = bool(page.get("terminal"))
                degraded = bool(page.get("diagnostics_degraded") or page.get("diagnosticsDegraded"))
                if next_cursor == cursor or terminal:
                    break
                cursor = next_cursor
        except RuntimeError as error:
            print(f"ERROR: {error}")
            return 1
        bundle["correlation"][kind] = url.split("/")[-2]
        bundle["diagnostics"] = items
        bundle["cleanup"] = {
            "confirmed": terminal,
            "detail": "terminal state reached" if terminal else "resource is still running",
        }
        bundle["diagnosticsDegraded"] = degraded
    elif trace_id:
        bundle["correlation"]["trace"] = trace_id
        home = dev_home()
        matches = []
        for path in sorted(home.rglob("*")):
            if not path.is_file() or path.suffix not in {".log", ".ndjson"}:
                continue
            try:
                content = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            matches.extend(line for line in content.splitlines() if trace_id in line)
        bundle["diagnostics"] = [{"source": "local_file", "message": line} for line in matches]
        bundle["cleanup"] = {
            "confirmed": False,
            "detail": f"trace lookup searched {home} without a resource identity",
        }
        if not matches:
            exit_code = 1
    else:
        print("ERROR: pass exactly one of --run, --deployment or --trace")
        return 2

    try:
        _write_private_json(output, bundle)
    except OSError as error:
        print(f"ERROR: could not write {output}: {error}")
        return 1
    print(f"Wrote {output} (mode 0600). It is not uploaded anywhere.")
    if exit_code:
        print("No matching records were found; the bundle records where it looked.")
    return exit_code


def _version_manifest() -> dict[str, Any]:
    """Collect the pinned versions and repository revisions in force."""

    manifest: dict[str, Any] = {"releaseLock": None, "engines": {}, "repositories": {}}
    lock_path = WORKSPACE_ROOT / "release-lock.json"
    if not lock_path.is_file():
        return manifest
    try:
        document = json.loads(lock_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        manifest["releaseLock"] = "unreadable"
        return manifest
    manifest["releaseLock"] = str(lock_path)
    for entry in (document.get("engines") or {}).values():
        if isinstance(entry, dict) and entry.get("package"):
            manifest["engines"][entry["package"]] = entry.get("acceptedVersion") or entry.get(
                "version"
            )
    for name, revision in (document.get("repositories") or {}).items():
        manifest["repositories"][name] = revision
    return manifest


def _write_private_json(path: Path, document: dict[str, Any]) -> None:
    """Write JSON readable only by the owner, creating parents as needed."""

    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, DIAGNOSTICS_BUNDLE_MODE)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        json.dump(document, stream, ensure_ascii=False, indent=2, sort_keys=True)
        stream.write("\n")
    os.chmod(path, DIAGNOSTICS_BUNDLE_MODE)


def cmd_bootstrap(args: argparse.Namespace) -> int:
    """Install, inspect, or repair the pinned training and serving runtime."""

    root = install_root()
    if getattr(args, "check", False):
        return _bootstrap_check(root)
    script = root / "bootstrap.sh"
    if not script.is_file():
        workspace_script = WORKSPACE_ROOT / "packaging" / "bootstrap.sh"
        if not workspace_script.is_file():
            print(f"ERROR: no bootstrap script found at {script} or {workspace_script}")
            return 1
        script = workspace_script
    action = "Repairing" if getattr(args, "repair", False) else "Installing"
    print(f"{action} the pinned runtime into {root} ...")
    environment = dict(os.environ)
    environment["INSTALL_ROOT"] = str(root)
    completed = subprocess.run([str(script)], env=environment, check=False)
    if completed.returncode != 0:
        print("ERROR: the runtime was not installed; the previous runtime is unchanged.")
        return completed.returncode
    print("Runtime installed. Run 'cyrene doctor' to verify it.")
    return 0


def _bootstrap_check(root: Path) -> int:
    """Report whether the pinned runtime is installed and complete."""

    all_passed = True
    lock_path = root / "release-lock.json"
    if lock_path.is_file():
        print(f"[OK] Release lock: {lock_path}")
    else:
        workspace_lock = WORKSPACE_ROOT / "release-lock.json"
        lock_path = workspace_lock if workspace_lock.is_file() else lock_path
        if lock_path.is_file():
            print(f"[OK] Release lock: {lock_path}")
        else:
            print("[FAIL] No release-lock.json found; engine pins are unknown")
            all_passed = False

    marker = root / BOOTSTRAP_STATE_FILE
    if marker.is_file():
        try:
            document = json.loads(marker.read_text(encoding="utf-8"))
            print(f"[OK] Bootstrap: {document.get('state', 'UNKNOWN')}")
        except (OSError, json.JSONDecodeError):
            print(f"[FAIL] Bootstrap marker at {marker} is unreadable")
            all_passed = False
    else:
        print(f"[FAIL] No bootstrap marker at {marker}; the runtime is not installed")
        all_passed = False

    venv_python = root / RUNTIME_VENV_DIR / "bin" / "python"
    if not venv_python.is_file():
        print(f"[FAIL] Runtime interpreter missing at {venv_python}")
        print("Bootstrap assessment: ISSUES FOUND.")
        return 1
    print(f"[OK] Runtime interpreter: {venv_python}")

    reporter = (
        "import importlib.metadata as m\n"
        "for name in ('vllm', 'llamafactory'):\n"
        "    try:\n"
        "        print(name, m.version(name))\n"
        "    except m.PackageNotFoundError:\n"
        "        print(name, 'MISSING')\n"
    )
    completed = subprocess.run(
        [str(venv_python), "-c", reporter], capture_output=True, text=True, check=False
    )
    if completed.returncode != 0:
        print(f"[FAIL] Runtime engines could not be inspected: {completed.stderr.strip()[:200]}")
        return 1
    for line in completed.stdout.strip().splitlines():
        name, _, version = line.partition(" ")
        if version == "MISSING":
            print(f"[FAIL] {name}: not installed in the runtime environment")
            all_passed = False
        else:
            print(f"[OK] {name}: {version}")

    print("Bootstrap assessment: READY." if all_passed else "Bootstrap assessment: ISSUES FOUND.")
    return 0 if all_passed else 1


def cmd_model_import(args: argparse.Namespace) -> int:
    reactor_url = os.environ.get("CYRENE_REACTOR_URL", "http://127.0.0.1:19300")
    endpoint = f"{reactor_url.rstrip('/')}/api/v1/model-imports"

    if args.hf:
        source = {
            "kind": "HUGGING_FACE",
            "repository": args.hf,
        }
        if args.revision:
            source["revision"] = args.revision
        default_name = args.hf.split("/")[-1]
    elif args.path:
        local_path = str(Path(args.path).resolve())
        if not Path(local_path).exists():
            print(f"Error: Local path does not exist: {local_path}", file=sys.stderr)
            return 1
        source = {
            "kind": "LOCAL_PATH",
            "path": local_path,
        }
        default_name = Path(local_path).name
    else:
        print("Error: Specify either --hf <repo> or --path <local_dir>", file=sys.stderr)
        return 1

    name = args.name or default_name
    binding_id = args.binding or "local-gpu"
    payload = {
        "name": name,
        "serving_binding_id": binding_id,
        "source": source,
        "trust_remote_code": False,
    }

    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Idempotency-Key": f"cli-import-{secrets.token_hex(8)}",
        },
        method="POST",
    )
    print(f"Sending model import request to Reactor ({endpoint})...")
    try:
        with urllib.request.urlopen(req, timeout=30.0) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            print("Model import initiated successfully:")
            print(json.dumps(data, indent=2))
            return 0
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        print(f"Error from Reactor ({e.code}): {body}", file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(f"Failed to connect to Reactor at {reactor_url}: {e.reason}", file=sys.stderr)
        print("Ensure Cyrene services are running (`cyrene up`).", file=sys.stderr)
        return 1


def cmd_backup(args: argparse.Namespace) -> int:
    home = dev_home()
    if not home.is_dir():
        print(f"Data directory does not exist: {home}", file=sys.stderr)
        return 1

    dest = Path(args.dest).resolve()
    if dest.is_dir() or str(args.dest).endswith("/"):
        timestamp = time.strftime("%Y%m%d-%H%M%S")
        target_archive = dest / f"cyrene-backup-{timestamp}.tar.gz"
    else:
        target_archive = dest

    if target_archive == home or target_archive.is_relative_to(home):
        print(
            f"Backup destination must be outside the data directory: {target_archive}",
            file=sys.stderr,
        )
        return 1

    target_archive.parent.mkdir(parents=True, exist_ok=True)
    temporary_archive = target_archive.with_name(
        f".{target_archive.name}.{secrets.token_hex(8)}.tmp"
    )
    print(f"Creating backup from {home} to {target_archive}...")
    try:
        with tarfile.open(temporary_archive, "w:gz") as tar:
            tar.add(home, arcname="cyrene-dev")
        os.replace(temporary_archive, target_archive)
    except (OSError, tarfile.TarError) as exc:
        temporary_archive.unlink(missing_ok=True)
        print(f"Backup failed without replacing the destination: {exc}", file=sys.stderr)
        return 1

    size_mb = target_archive.stat().st_size / (1024 * 1024)
    print(f"Backup completed successfully ({size_mb:.2f} MiB): {target_archive}")
    return 0


def _validate_backup_members(members: list[tarfile.TarInfo]) -> None:
    if not members:
        raise ValueError("backup archive is empty")
    for member in members:
        name = member.name
        path = PurePosixPath(name)
        if (
            not name
            or "\\" in name
            or path.is_absolute()
            or ".." in path.parts
            or not path.parts
            or path.parts[0] != "cyrene-dev"
        ):
            raise ValueError(f"backup member escapes the cyrene-dev root: {name!r}")


def _stage_restore_source(src: Path, staging_root: Path) -> Path:
    staged_home = staging_root / "cyrene-dev"
    if tarfile.is_tarfile(src):
        with tarfile.open(src, "r:*") as archive:
            members = archive.getmembers()
            _validate_backup_members(members)
            archive.extractall(path=staging_root, members=members, filter="data")
    elif src.is_dir():
        source_home = src / "cyrene-dev" if (src / "cyrene-dev").is_dir() else src
        shutil.copytree(source_home, staged_home, symlinks=True)
    else:
        raise ValueError(f"unsupported backup format: {src}")

    if not staged_home.is_dir() or staged_home.is_symlink():
        raise ValueError("backup must contain a real cyrene-dev directory")
    return staged_home


def _replace_home(staged_home: Path, home: Path) -> None:
    previous_home = home.parent / f".{home.name}.restore-previous-{secrets.token_hex(8)}"
    moved_previous = False
    try:
        if home.exists():
            os.replace(home, previous_home)
            moved_previous = True
        os.replace(staged_home, home)
    except OSError as replace_error:
        if moved_previous and previous_home.exists() and not home.exists():
            try:
                os.replace(previous_home, home)
            except OSError as rollback_error:
                raise OSError(
                    f"restore replacement failed ({replace_error}); rollback also failed "
                    f"({rollback_error}); previous data remains at {previous_home}"
                ) from rollback_error
        raise
    if moved_previous:
        try:
            shutil.rmtree(previous_home)
        except OSError as exc:
            print(
                f"Warning: restored data, but could not remove {previous_home}: {exc}",
                file=sys.stderr,
            )
    home.chmod(0o700)


def cmd_restore(args: argparse.Namespace) -> int:
    src = Path(args.src).resolve()
    if not src.exists():
        print(f"Backup source does not exist: {src}", file=sys.stderr)
        return 1

    home = dev_home()
    if home.exists() and not home.is_dir():
        print(f"Data path is not a directory: {home}", file=sys.stderr)
        return 1
    if src == home or src.is_relative_to(home) or home.is_relative_to(src):
        print(
            "Backup source and data directory must not contain one another.",
            file=sys.stderr,
        )
        return 1

    pids_file = home / "pids.json"
    if pids_file.is_file():
        print("Warning: Cyrene services appear to be active. Stopping services before restore...")
        if cmd_down(args) != 0:
            print("Restore aborted because Cyrene services could not be stopped.", file=sys.stderr)
            return 1

    print(f"Restoring backup from {src} to {home}...")
    home.parent.mkdir(parents=True, exist_ok=True)
    try:
        with tempfile.TemporaryDirectory(prefix=".cyrene-restore-", dir=home.parent) as staging:
            staged_home = _stage_restore_source(src, Path(staging))
            _replace_home(staged_home, home)
    except (OSError, tarfile.TarError, ValueError) as exc:
        print(f"Restore failed; the existing data directory was preserved: {exc}", file=sys.stderr)
        return 1

    print("Restore completed successfully.")
    return 0


def _open_service_state_directory(
    bundle_module: Any, service: str, *, create: bool
) -> tuple[Path, int]:
    """Open one verified root-owned service directory without following its final link."""

    root = bundle_module.ensure_secure_service_root(
        service, install_root=service_install_root(), create=create
    )
    descriptor = os.open(
        root,
        os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    info = os.fstat(descriptor)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        os.close(descriptor)
        raise ValueError(f"service state directory is not secure: {root}")
    return root, descriptor


def _service_update_journal_exists(bundle_module: Any, service: str) -> bool:
    """Fail closed when any journal entry exists, without needing service-user read access."""

    root_path = service_install_root() / "services" / service
    if not root_path.exists() and not root_path.is_symlink():
        return False
    _, directory_fd = _open_service_state_directory(bundle_module, service, create=False)
    try:
        try:
            os.stat(SERVICE_UPDATE_JOURNAL_NAME, dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            return False
        return True
    finally:
        os.close(directory_fd)


def _read_service_update_journal(bundle_module: Any, service: str) -> dict[str, Any] | None:
    """Read and validate the private root-owned update intent record."""

    if not _service_update_journal_exists(bundle_module, service):
        return None
    _, directory_fd = _open_service_state_directory(bundle_module, service, create=False)
    try:
        file_fd = os.open(
            SERVICE_UPDATE_JOURNAL_NAME,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=directory_fd,
        )
        with os.fdopen(file_fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0
                or stat.S_IMODE(info.st_mode) != 0o600
            ):
                raise ValueError("service update journal is not a root-owned 0600 regular file")
            try:
                value = json.loads(stream.read().decode("utf-8"))
            except (UnicodeError, json.JSONDecodeError) as error:
                raise ValueError(f"service update journal is invalid: {error}") from error
    finally:
        os.close(directory_fd)

    expected_keys = {
        "schema_version",
        "service",
        "previous_version",
        "candidate_version",
    }
    if not isinstance(value, dict) or set(value) != expected_keys:
        raise ValueError("service update journal has an unsupported shape")
    if (
        type(value["schema_version"]) is not int
        or value["schema_version"] != 1
        or value["service"] != service
    ):
        raise ValueError("service update journal identity does not match this service")
    previous_version = value["previous_version"]
    candidate_version = value["candidate_version"]
    if (
        not isinstance(previous_version, str)
        or not SERVICE_RELEASE_VERSION_PATTERN.fullmatch(previous_version)
        or not isinstance(candidate_version, str)
        or not SERVICE_RELEASE_VERSION_PATTERN.fullmatch(candidate_version)
        or previous_version == candidate_version
    ):
        raise ValueError("service update journal contains invalid release identities")
    return value


def _write_service_update_journal(
    bundle_module: Any, service: str, previous_version: str, candidate_version: str
) -> None:
    """Durably record intent before the active release pointer can change."""

    if not SERVICE_RELEASE_VERSION_PATTERN.fullmatch(previous_version):
        raise ValueError("previous service release identity is invalid")
    if not SERVICE_RELEASE_VERSION_PATTERN.fullmatch(candidate_version):
        raise ValueError("candidate service release identity is invalid")
    root, directory_fd = _open_service_state_directory(bundle_module, service, create=True)
    temporary_name = f".update-journal-{os.getpid()}-{secrets.token_hex(8)}.tmp"
    payload = json.dumps(
        {
            "schema_version": 1,
            "service": service,
            "previous_version": previous_version,
            "candidate_version": candidate_version,
        },
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    descriptor: int | None = None
    try:
        try:
            os.stat(SERVICE_UPDATE_JOURNAL_NAME, dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise ValueError(f"an unresolved service update journal already exists under {root}")
        descriptor = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=directory_fd,
        )
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
            raise ValueError("temporary service update journal is not a root-owned regular file")
        with os.fdopen(descriptor, "wb") as stream:
            descriptor = None
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(
            temporary_name,
            SERVICE_UPDATE_JOURNAL_NAME,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        os.fsync(directory_fd)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        try:
            os.unlink(temporary_name, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        os.close(directory_fd)


def _remove_service_update_journal(bundle_module: Any, service: str) -> None:
    """Remove a verified transaction record and persist its directory update."""

    _, directory_fd = _open_service_state_directory(bundle_module, service, create=False)
    try:
        try:
            file_fd = os.open(
                SERVICE_UPDATE_JOURNAL_NAME,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=directory_fd,
            )
        except FileNotFoundError:
            return
        with os.fdopen(file_fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0
                or stat.S_IMODE(info.st_mode) != 0o600
            ):
                raise ValueError("refusing to remove an unsafe service update journal")
        os.unlink(SERVICE_UPDATE_JOURNAL_NAME, dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _active_version_from_pointer(bundle_module: Any, service: str) -> str | None:
    """Read the active symlink identity even when its pointed-to candidate is invalid."""

    _, directory_fd = _open_service_state_directory(bundle_module, service, create=False)
    try:
        try:
            info = os.stat("active", dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            return None
        if not stat.S_ISLNK(info.st_mode) or info.st_uid != 0:
            raise ValueError("active service release pointer is not a root-owned symlink")
        target = os.readlink("active", dir_fd=directory_fd)
    finally:
        os.close(directory_fd)
    match = re.fullmatch(r"releases/([0-9a-f]{64})", target)
    if match is None:
        raise ValueError(f"active service release pointer is unsafe: {target!r}")
    return match.group(1)


def _root_update_process_holds_lock(lock_info: os.stat_result, service: str) -> bool:
    """Verify the exclusive lock owner is a root `cyrene upgrade <service>` process."""

    lock_identity = (
        f"{os.major(lock_info.st_dev):02x}:{os.minor(lock_info.st_dev):02x}:{lock_info.st_ino}"
    )
    try:
        lock_records = Path("/proc/locks").read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    for record in lock_records:
        fields = record.split()
        if (
            len(fields) < 6
            or fields[1] != "FLOCK"
            or fields[3] != "WRITE"
            or fields[5].lower() != lock_identity.lower()
            or not fields[4].isdigit()
        ):
            continue
        pid = fields[4]
        try:
            status = Path(f"/proc/{pid}/status").read_text(encoding="utf-8")
            command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        uid_line = next((line for line in status.splitlines() if line.startswith("Uid:")), "")
        uid_values = uid_line.split()
        arguments = [value.decode("utf-8", errors="surrogateescape") for value in command if value]
        if (
            len(uid_values) >= 2
            and uid_values[1] == "0"
            and "upgrade" in arguments
            and service in arguments
            and any(Path(argument).name == "cyrene" for argument in arguments)
        ):
            return True
    return False


def _open_update_runtime_directory(service_gid: int, *, create: bool) -> int:
    """Open `/run/cyrene` after enforcing its root-controlled ownership and mode."""

    run_info = Path("/run").lstat()
    if not stat.S_ISDIR(run_info.st_mode) or run_info.st_uid != 0 or run_info.st_mode & 0o022:
        raise OSError("/run is not a root-owned, non-writable directory")
    if create:
        try:
            os.mkdir(SERVICE_UPDATE_RUNTIME_DIR, mode=0o750)
        except FileExistsError:
            pass

    path_info = SERVICE_UPDATE_RUNTIME_DIR.lstat()
    if not stat.S_ISDIR(path_info.st_mode) or path_info.st_uid != 0 or path_info.st_mode & 0o022:
        raise OSError("/run/cyrene is not a safe root-owned directory")
    directory_fd = os.open(
        SERVICE_UPDATE_RUNTIME_DIR,
        os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        if create:
            os.fchown(directory_fd, 0, service_gid)
            os.fchmod(directory_fd, 0o750)
        info = os.fstat(directory_fd)
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != service_gid
            or stat.S_IMODE(info.st_mode) != 0o750
        ):
            raise OSError("/run/cyrene must be root:cyrene with mode 0750")
        return directory_fd
    except OSError:
        os.close(directory_fd)
        raise


def _service_update_in_progress(service: str) -> bool:
    """Allow journaled service startup only while a verified root updater holds its lock."""

    directory_fd: int | None = None
    try:
        import fcntl
        import grp

        service_gid = grp.getgrnam("cyrene").gr_gid
        directory_fd = _open_update_runtime_directory(service_gid, create=False)
        lock_fd = os.open(
            f"service-update-{service}.lock",
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=directory_fd,
        )
    except (ImportError, KeyError, OSError):
        if directory_fd is not None:
            os.close(directory_fd)
        return False
    try:
        info = os.fstat(lock_fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != service_gid
            or stat.S_IMODE(info.st_mode) != 0o640
        ):
            return False
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return _root_update_process_holds_lock(info, service)
        else:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            return False
    except OSError:
        return False
    finally:
        os.close(lock_fd)
        os.close(directory_fd)


def _systemd_update_preflight(service: str, *, require_active: bool = True) -> tuple[bool, str]:
    """Confirm systemd owns a unit whose ExecStart uses the foreground service runner."""

    if not Path("/run/systemd/system").exists() or shutil.which("systemctl") is None:
        return (
            False,
            "systemd is unavailable; source-checkout cyrene up mode has no immutable updater",
        )

    unit = f"cyrene-{service}.service"
    loaded = subprocess.run(
        ["systemctl", "show", "--property=LoadState", "--value", unit],
        capture_output=True,
        text=True,
        check=False,
    )
    if loaded.returncode != 0 or loaded.stdout.strip() != "loaded":
        return False, f"systemd unit {unit} is not loaded"

    exec_start = subprocess.run(
        ["systemctl", "show", "--property=ExecStart", "--value", unit],
        capture_output=True,
        text=True,
        check=False,
    )
    expected_command = f"argv[]=/usr/bin/cyrene service-run {service}"
    if exec_start.returncode != 0 or expected_command not in exec_start.stdout:
        return False, f"{unit} does not use the per-service foreground runner"

    active = subprocess.run(
        ["systemctl", "is-active", "--quiet", unit],
        capture_output=True,
        text=True,
        check=False,
    )
    if require_active and active.returncode != 0:
        return False, f"{unit} is not active; refusing to start a service that was stopped"
    return True, unit


def _systemd_unit_loaded(service: str) -> bool:
    """Report whether systemd has loaded this packaged service unit."""

    if not Path("/run/systemd/system").exists() or shutil.which("systemctl") is None:
        return False
    result = subprocess.run(
        ["systemctl", "show", "--property=LoadState", "--value", f"cyrene-{service}.service"],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "loaded"


def _loaded_systemd_units() -> list[str]:
    """Return only the five Cyrene units this package owns and systemd loaded."""

    if not Path("/run/systemd/system").exists() or shutil.which("systemctl") is None:
        return []
    return [
        f"{unit}.service"
        for unit in SYSTEMD_UNITS
        if _systemd_unit_loaded(unit.removeprefix("cyrene-"))
    ]


def _systemd_unit_state(unit: str) -> tuple[str, str, str] | None:
    """Read the load, active, and sub-state fields for one managed unit."""

    result = subprocess.run(
        ["systemctl", "show", "--property=LoadState,ActiveState,SubState", unit],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    fields = dict(line.partition("=")[::2] for line in result.stdout.splitlines() if "=" in line)
    load_state = fields.get("LoadState")
    active_state = fields.get("ActiveState")
    sub_state = fields.get("SubState")
    if load_state is None or active_state is None or sub_state is None:
        return None
    return load_state, active_state, sub_state


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Keep health probes on loopback instead of following external redirects."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # type: ignore[override]
        return None


def _validate_health_path(health_path: str) -> None:
    """Reject release health targets that could leave the local service path."""

    parsed_path = PurePosixPath(health_path)
    if (
        not health_path.startswith("/")
        or "?" in health_path
        or "#" in health_path
        or ".." in parsed_path.parts
    ):
        raise ValueError("release manifest health.path must be a local absolute URL path")


def _service_health_port(service: str) -> int:
    """Read the service port from its systemd EnvironmentFile or unit default."""

    key = SYSTEMD_HEALTH_ENV_KEYS[service]
    configured: str | None = None
    environment_file = Path("/etc/cyrene/cyrene.env")
    if environment_file.is_file():
        for line in environment_file.read_text(encoding="utf-8").splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            name, separator, value = stripped.partition("=")
            if separator and name.strip() == key:
                configured = value.strip().strip("\"'")
    value = configured or str(SYSTEMD_HEALTH_PORTS[service])
    try:
        port = int(value)
    except ValueError as error:
        raise ValueError(f"{key} in /etc/cyrene/cyrene.env must be an integer") from error
    if not 1 <= port <= 65535:
        raise ValueError(f"{key} must be between 1 and 65535")
    return port


def _service_health_probe(service: str, health_path: str) -> tuple[bool, str]:
    """Check the service's local health endpoint without following redirects."""

    try:
        _validate_health_path(health_path)
    except ValueError as error:
        return False, str(error)
    try:
        port = _service_health_port(service)
    except (OSError, ValueError) as error:
        return False, f"health port configuration is invalid: {error}"
    url = f"http://127.0.0.1:{port}{health_path}"
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "CyreneUpdater/1", "Accept": "application/json"},
    )
    opener = urllib.request.build_opener(_NoRedirectHandler())
    try:
        with opener.open(request, timeout=3.0) as response:
            status = int(response.status)
    except urllib.error.HTTPError as error:
        return False, f"health endpoint returned HTTP {error.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        return False, f"health endpoint is unavailable: {error}"
    if not 200 <= status < 300:
        return False, f"health endpoint returned HTTP {status}"
    return True, f"HTTP {status}"


def _systemd_process_uses_release(unit: str, entrypoint: Path) -> tuple[bool, str]:
    """Confirm the main process inherited PYTHONPATH from the selected immutable release."""

    result = subprocess.run(
        ["systemctl", "show", "--property=MainPID", "--value", unit],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip().isdigit():
        return False, f"{unit} has no readable MainPID"
    pid = int(result.stdout.strip())
    if pid <= 1:
        return False, f"{unit} has no running main process"
    try:
        environment = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        executable = Path(f"/proc/{pid}/exe").resolve().name
    except OSError as error:
        return False, f"cannot inspect {unit} process {pid} release identity: {error}"
    expected_pythonpath = os.fsencode(str(entrypoint.parent / "python"))
    observed_pythonpath = next(
        (value.partition(b"=")[2] for value in environment if value.startswith(b"PYTHONPATH=")),
        None,
    )
    if "python" not in executable.lower() or observed_pythonpath != expected_pythonpath:
        return False, f"{unit} MainPID {pid} is not bound to the selected immutable release"
    return True, f"MainPID {pid} is bound to the selected immutable release"


def _wait_for_service_ready(
    service: str, unit: str, health_path: str, entrypoint: Path
) -> tuple[bool, str]:
    """Wait for the selected unit process and its service-specific endpoint to be ready."""

    deadline = time.monotonic() + SERVICE_UPDATE_TIMEOUT_SECONDS
    last_reason = "service has not reported ready"
    while time.monotonic() < deadline:
        active = subprocess.run(
            ["systemctl", "is-active", "--quiet", unit],
            capture_output=True,
            text=True,
            check=False,
        )
        if active.returncode == 0:
            process_ok, process_reason = _systemd_process_uses_release(unit, entrypoint)
            if process_ok:
                healthy, reason = _service_health_probe(service, health_path)
                if healthy:
                    return True, f"{process_reason}; {reason}"
                last_reason = reason
            else:
                last_reason = process_reason
        else:
            last_reason = f"{unit} is not active"
        time.sleep(2.0)
    return False, last_reason


def _restart_service_unit(unit: str) -> tuple[bool, str]:
    """Restart one systemd unit and preserve its diagnostic on failure."""

    result = subprocess.run(
        ["systemctl", "restart", unit],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        return True, ""
    detail = result.stderr.strip() or result.stdout.strip() or f"exit code {result.returncode}"
    return False, detail


def _packaged_service_bundle(service: str, bundle_module: Any) -> Path | None:
    """Find and validate the single bundle staged by the current Debian package."""

    service_dir = Path("/usr/share/cyrene/service-artifacts") / service
    if not service_dir.exists() and not service_dir.is_symlink():
        return None
    if service_dir.is_symlink() or not service_dir.is_dir():
        raise ValueError(f"packaged {service} artifact path is unsafe: {service_dir}")
    candidates = sorted(path for path in service_dir.iterdir() if path.is_dir())
    if len(candidates) != 1:
        raise ValueError(
            f"expected one package-provided {service} bundle in {service_dir}, "
            f"found {len(candidates)}"
        )
    manifest = bundle_module.validate_bundle(candidates[0], expected_service=service)
    if candidates[0].name != manifest["version"]:
        raise ValueError(f"package bundle directory does not match its {service} manifest version")
    return candidates[0]


def _recover_service_update_locked(service: str, unit: str) -> tuple[bool, bool, str]:
    """Restore the journaled prior release before allowing a unit to launch."""

    try:
        bundle_module = _load_service_bundle_module()
        journal = _read_service_update_journal(bundle_module, service)
        if journal is None:
            return False, True, ""
        previous_version = journal["previous_version"]
        candidate_version = journal["candidate_version"]
        previous_dir = service_install_root() / "services" / service / "releases" / previous_version
        previous_manifest = bundle_module.validate_bundle(previous_dir, expected_service=service)
        if previous_manifest["version"] != previous_version:
            raise ValueError("journaled previous release directory does not match its identity")
        health_path = str(previous_manifest["health"]["path"])
        _validate_health_path(health_path)
        current_version = _active_version_from_pointer(bundle_module, service)
        if current_version not in {None, previous_version, candidate_version}:
            raise ValueError(
                f"active release {current_version} is neither journaled release; refusing recovery"
            )
        if current_version != previous_version:
            bundle_module.activate_release(
                service,
                previous_version,
                install_root=service_install_root(),
                expected_current_version=current_version,
            )
        selected = bundle_module.resolve_active_release(
            service, install_root=service_install_root()
        )
        if selected is None or selected[1] != previous_version:
            raise RuntimeError("the previous release did not become active during recovery")
        previous_entrypoint = selected[0]
    except (ImportError, KeyError, OSError, RuntimeError, TypeError, ValueError) as error:
        return True, False, f"could not restore the journaled prior release: {error}"

    restart_ok, restart_error = _restart_service_unit(unit)
    if not restart_ok:
        return (
            True,
            False,
            f"restored {previous_version}, but restarting {unit} failed: {restart_error}",
        )
    ready, reason = _wait_for_service_ready(service, unit, health_path, previous_entrypoint)
    if not ready:
        return True, False, f"restored {previous_version}, but readiness failed: {reason}"
    try:
        _remove_service_update_journal(bundle_module, service)
    except (OSError, RuntimeError, ValueError) as error:
        return (
            True,
            False,
            f"restored and verified {previous_version}, but journal cleanup failed: {error}",
        )
    return True, True, f"restored and verified prior release {previous_version} ({reason})"


def _upgrade_service_locked(service: str, bundle_path: Path) -> int:
    """Stage, activate, verify, and roll back one immutable service release."""

    try:
        bundle_module = _load_service_bundle_module()
        old_active = bundle_module.resolve_active_release(
            service, install_root=service_install_root()
        )
        if old_active is None:
            print(
                f"UNSUPPORTED: {service} has no active immutable release to restore; "
                "the mutable legacy install is not a rollback-safe baseline.",
                file=sys.stderr,
            )
            return 2
        _old_entrypoint, old_version = old_active
        old_release_dir = service_install_root() / "services" / service / "releases" / old_version
        old_manifest = bundle_module.validate_bundle(old_release_dir, expected_service=service)
        new_manifest = bundle_module.validate_bundle(bundle_path, expected_service=service)
        new_version = str(new_manifest["version"])
        new_health_path = str(new_manifest["health"]["path"])
        old_health_path = str(old_manifest["health"]["path"])
        _validate_health_path(new_health_path)
        _validate_health_path(old_health_path)
        _service_health_port(service)
    except (ImportError, KeyError, OSError, RuntimeError, TypeError, ValueError) as error:
        print(f"ERROR: service release validation failed: {error}", file=sys.stderr)
        return 1

    if new_version == old_version:
        print(f"{service} is already on release {old_version}; no restart was performed.")
        return 0

    release_dir = service_install_root() / "services" / service / "releases" / new_version
    try:
        if release_dir.exists():
            # Reuse a failed candidate only when its complete manifest is identical.
            staged_manifest = bundle_module.validate_bundle(release_dir, expected_service=service)
            if staged_manifest != new_manifest:
                raise ValueError("an existing release has different manifest contents")
        else:
            staged_release = bundle_module.stage_release(
                bundle_path, install_root=service_install_root()
            )
            staged_manifest = bundle_module.validate_bundle(
                staged_release, expected_service=service
            )
            if staged_manifest != new_manifest:
                raise ValueError("staged release manifest differs from the validated bundle")
    except (KeyError, OSError, RuntimeError, TypeError, ValueError) as error:
        print(f"ERROR: could not stage {service} {new_version}: {error}", file=sys.stderr)
        return 1

    try:
        _write_service_update_journal(bundle_module, service, old_version, new_version)
        bundle_module.activate_release(
            service,
            new_version,
            install_root=service_install_root(),
            expected_current_version=old_version,
        )
        active_release = bundle_module.resolve_active_release(
            service, install_root=service_install_root()
        )
        if active_release is None or active_release[1] != new_version:
            raise RuntimeError("new release did not become the active service version")
        new_entrypoint = active_release[0]
    except (KeyError, OSError, RuntimeError, TypeError, ValueError) as error:
        recovered, restored, recovery_reason = _recover_service_update_locked(
            service, f"cyrene-{service}.service"
        )
        if recovered and restored:
            print(
                f"ERROR: could not activate {service} {new_version}: {error}. {recovery_reason}.",
                file=sys.stderr,
            )
        elif not recovered:
            print(
                f"ERROR: could not activate {service} {new_version}: {error}; "
                "the active release was not changed and no transaction journal remains.",
                file=sys.stderr,
            )
        else:
            print(
                f"ROLLBACK REQUIRED: could not activate {service} {new_version}: {error}. "
                f"{recovery_reason or 'transaction journal remains for recovery'}.",
                file=sys.stderr,
            )
        return 1

    unit = f"cyrene-{service}.service"
    restart_ok, restart_error = _restart_service_unit(unit)
    if restart_ok:
        ready, ready_reason = _wait_for_service_ready(
            service, unit, new_health_path, new_entrypoint
        )
    else:
        ready, ready_reason = False, f"systemd restart failed: {restart_error}"
    if ready:
        try:
            active_release = bundle_module.resolve_active_release(
                service, install_root=service_install_root()
            )
            if active_release is None or active_release[1] != new_version:
                raise RuntimeError("active release pointer changed during readiness verification")
        except (OSError, RuntimeError, ValueError) as error:
            ready, ready_reason = False, f"release verification failed: {error}"
    if ready:
        try:
            _remove_service_update_journal(bundle_module, service)
        except (OSError, RuntimeError, ValueError) as error:
            print(
                f"ERROR: {service} {new_version} is healthy, but its update journal could not "
                f"be cleared ({error}); service-run will fail closed until recovery.",
                file=sys.stderr,
            )
            return 1
        print(
            f"Updated {service} from {old_version} to {new_version}; only {unit} was restarted "
            f"and its health endpoint returned {ready_reason}."
        )
        return 0

    print(
        f"{service} release {new_version} did not become ready ({ready_reason}); "
        f"restoring {old_version}.",
        file=sys.stderr,
    )
    recovered, restored, recovery_reason = _recover_service_update_locked(service, unit)
    if not recovered or not restored:
        print(
            f"ROLLBACK INCOMPLETE: {recovery_reason or 'the update journal is missing'}; "
            "service-run will fail closed until recovery.",
            file=sys.stderr,
        )
        return 1
    print(f"Rolled {service} back to {old_version}; {recovery_reason}.", file=sys.stderr)
    return 1


def _upgrade_service(service: str, bundle_path: Path | None) -> int:
    """Serialize root-owned per-service update transactions with a lock file."""

    if not Path("/run/systemd/system").exists() or shutil.which("systemctl") is None:
        print(
            "UNSUPPORTED: cyrene up development mode uses source checkouts and has no "
            "immutable systemd release to roll back to; no process was changed.",
            file=sys.stderr,
        )
        return 2
    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        print("ERROR: per-service updates must run as root (use sudo).", file=sys.stderr)
        return 1

    directory_fd: int | None = None
    try:
        import fcntl
        import grp

        service_gid = grp.getgrnam("cyrene").gr_gid
        directory_fd = _open_update_runtime_directory(service_gid, create=True)
        lock_fd = os.open(
            f"service-update-{service}.lock",
            os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=directory_fd,
        )
    except (ImportError, KeyError, OSError) as error:
        if directory_fd is not None:
            os.close(directory_fd)
        print(f"ERROR: cannot create the service update lock: {error}", file=sys.stderr)
        return 1

    try:
        lock_stat = os.fstat(lock_fd)
        if (
            not stat.S_ISREG(lock_stat.st_mode)
            or lock_stat.st_uid != 0
            or (lock_stat.st_mode & 0o022)
        ):
            print("ERROR: service update lock is not root-owned and private.", file=sys.stderr)
            return 1
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(f"ERROR: another {service} update is already in progress.", file=sys.stderr)
            return 1

        try:
            service_gid = grp.getgrnam("cyrene").gr_gid
            os.fchown(lock_fd, 0, service_gid)
            os.fchmod(lock_fd, 0o640)
        except (KeyError, OSError) as error:
            print(
                f"ERROR: cannot expose the update lock safely to the service runner: {error}",
                file=sys.stderr,
            )
            return 1
        lock_stat = os.fstat(lock_fd)
        if (
            lock_stat.st_uid != 0
            or lock_stat.st_gid != service_gid
            or stat.S_IMODE(lock_stat.st_mode) != 0o640
        ):
            print("ERROR: service update lock permissions are invalid.", file=sys.stderr)
            return 1

        ready, detail = _systemd_update_preflight(service, require_active=False)
        if not ready:
            print(f"UNSUPPORTED: {detail}; no service was changed.", file=sys.stderr)
            return 2

        try:
            bundle_module = _load_service_bundle_module()
            pending = _read_service_update_journal(bundle_module, service)
        except (ImportError, OSError, RuntimeError, TypeError, ValueError) as error:
            print(f"ERROR: cannot inspect {service} update state: {error}", file=sys.stderr)
            return 1
        if pending is not None:
            recovered, restored, recovery_reason = _recover_service_update_locked(
                service, f"cyrene-{service}.service"
            )
            if recovered and restored:
                print(
                    f"Interrupted update recovered: {recovery_reason}. "
                    "The requested candidate was not retried; run the upgrade command again "
                    "after reviewing service status."
                )
                return 0
            print(f"ROLLBACK INCOMPLETE: {recovery_reason}.", file=sys.stderr)
            return 1

        ready, detail = _systemd_update_preflight(service)
        if not ready:
            print(f"UNSUPPORTED: {detail}; no service was changed.", file=sys.stderr)
            return 2
        if bundle_path is None:
            try:
                bundle_path = _packaged_service_bundle(service, bundle_module)
            except (OSError, RuntimeError, ValueError) as error:
                print(f"ERROR: package update bundle is invalid: {error}", file=sys.stderr)
                return 1
        if bundle_path is None:
            print(
                f"No staged update bundle exists for {service}. Install a package containing "
                "service artifacts or pass --artifact <bundle-directory>.",
                file=sys.stderr,
            )
            return 2
        return _upgrade_service_locked(service, bundle_path)
    finally:
        os.close(lock_fd)
        os.close(directory_fd)


def cmd_update(args: argparse.Namespace) -> int:
    """Run the single fixed JSON stdin/stdout component-update helper."""

    if not getattr(args, "json", False):
        print(
            "ERROR: component updates require the fixed `cyrene update --json` protocol.",
            file=sys.stderr,
        )
        return 2
    try:
        module = _load_component_updates_module()
        updater = module.ComponentUpdater()
    except Exception as error:  # noqa: BLE001 - convert every helper startup failure to the fixed JSON response.
        print(
            json.dumps(
                {
                    "protocolVersion": "cyrene.component-updates.helper.v1",
                    "ok": False,
                    "operation": "status",
                    "error": {
                        "code": "HELPER_UNAVAILABLE",
                        "message": f"The trusted component update helper is unavailable: {error}",
                        "retryable": True,
                    },
                },
                ensure_ascii=False,
                separators=(",", ":"),
            )
        )
        return 0
    return module.run_json_stdio(updater)


def cmd_component_run(args: argparse.Namespace) -> int:
    """Execute one catalog-pinned native release for a systemd unit.

    Startup arguments are accepted only on this direct CLI path. They come
    from the root-owned unit definition, never from the update JSON protocol.
    """

    try:
        module = _load_component_updates_module()
        updater = module.ComponentUpdater()
        component = updater.components.get(args.component_id)
        target = updater._target_for(component) if component is not None else None
        if (
            component is None
            or component.get("kind") != "native-binary"
            or target is None
            or target.get("artifactKind") != "native-binary"
            or not component.get("systemdUnit")
        ):
            raise ValueError(f"{args.component_id!r} is not a supported native systemd component.")

        startup_arguments = list(getattr(args, "startup_arguments", []))
        if startup_arguments and startup_arguments[0] == "--":
            startup_arguments.pop(0)
        if len(startup_arguments) > 64 or any(
            not isinstance(argument, str)
            or not argument
            or "\x00" in argument
            or len(argument.encode("utf-8")) > 512
            for argument in startup_arguments
        ):
            raise ValueError(
                "Startup arguments must be non-empty UTF-8 values of at most 512 bytes each (64 maximum)."
            )

        return module.run_component(
            args.component_id,
            install_root=Path(module.DEFAULT_INSTALL_ROOT),
            startup_arguments=startup_arguments,
        )
    except Exception as error:  # noqa: BLE001 - report component startup failures through the CLI boundary.
        print(
            f"ERROR: cannot start trusted component {args.component_id}: {error}", file=sys.stderr
        )
        return 1


def _validate_installed_native_component(
    module: Any,
    updater: Any,
    component: dict[str, Any],
    install_root_path: Path,
) -> tuple[Path, dict[str, Any], bytes]:
    """Validate an active native release and return its exact unit payload."""

    component_id = component["componentId"]
    unit = component.get("systemdUnit")
    if not isinstance(unit, str) or re.fullmatch(r"[A-Za-z0-9_.@-]+\.service", unit) is None:
        raise ValueError(f"Trusted unit name is invalid for {component_id}.")
    root = install_root_path / "components" / component_id
    active = root / "active"
    if not active.is_symlink():
        raise ValueError(f"No active native release is installed for {component_id}.")
    for directory in (install_root_path, install_root_path / "components", root, root / "releases"):
        info = directory.lstat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or directory.is_symlink()
            or info.st_uid != 0
            or stat.S_IMODE(info.st_mode) & 0o022
        ):
            raise ValueError(
                f"Active release path is not a root-owned real directory for {component_id}: {directory}."
            )
    active_info = active.lstat()
    if active_info.st_uid != 0:
        raise ValueError(f"Active release pointer is not root-owned for {component_id}.")
    match = re.fullmatch(r"releases/([^/]+)", os.readlink(active))
    if match is None:
        raise ValueError(f"Active release pointer is unsafe for {component_id}.")
    pointer_identity = match.group(1)
    version, pointer_digest = module._native_release_directory_identity(pointer_identity)
    if module.VERSION_PATTERN.fullmatch(version) is None:
        raise ValueError(f"Active release pointer has an invalid version for {component_id}.")
    release = root / "releases" / pointer_identity
    if release.is_symlink() or not release.is_dir():
        raise ValueError(f"Active release directory is unsafe for {component_id}.")
    release_info = release.lstat()
    if release_info.st_uid != 0 or stat.S_IMODE(release_info.st_mode) & 0o022:
        raise ValueError(f"Active release directory is not root-controlled for {component_id}.")
    manifest = module._read_object(
        release / "component-manifest.json", f"{component_id} release manifest"
    )
    manifest_info = (release / "component-manifest.json").lstat()
    if manifest_info.st_uid != 0 or stat.S_IMODE(manifest_info.st_mode) & 0o022:
        raise ValueError(f"Active component manifest is not root-controlled for {component_id}.")
    updater._validate_manifest_digest(manifest, manifest.get("manifestDigest"))
    artifact = manifest.get("artifact")
    if (
        manifest.get("componentId") != component_id
        or manifest.get("version") != version
        or (
            pointer_digest is not None
            and manifest.get("manifestDigest") != "sha256:" + pointer_digest
        )
        or (pointer_digest is None and pointer_identity != version)
        or not isinstance(artifact, dict)
        or artifact.get("kind") != "native-binary"
        or module.DIGEST_PATTERN.fullmatch(artifact.get("sha256", "")) is None
        or not isinstance(artifact.get("files"), dict)
    ):
        raise ValueError(
            f"Active release identity or artifact file map is invalid for {component_id}."
        )

    files: dict[str, str] = artifact["files"]
    unit_relative = f"systemd/{unit}"
    unit_digest = files.get(unit_relative)
    if not isinstance(unit_digest, str) or module.DIGEST_PATTERN.fullmatch(unit_digest) is None:
        raise ValueError(
            f"Active release does not pin its declared systemd unit for {component_id}."
        )
    entrypoint = module._safe_relative(artifact.get("entrypoint"), field="artifact.entrypoint")
    if entrypoint.as_posix() not in files:
        raise ValueError(
            f"Active release entrypoint is not covered by its file map for {component_id}."
        )

    for relative_name, expected_digest in files.items():
        if not isinstance(relative_name, str) or not isinstance(expected_digest, str):
            raise TypeError(f"Active release file map is malformed for {component_id}.")
        relative = module._safe_relative(relative_name, field="artifact.files path")
        if module.DIGEST_PATTERN.fullmatch(expected_digest) is None:
            raise ValueError(f"Active release file digest is malformed for {component_id}.")
        payload_path = release.joinpath(*relative.parts)
        current = release
        for part in relative.parts:
            current = current / part
            info = current.lstat()
            if current.is_symlink() or (
                current != payload_path
                and (
                    not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != 0
                    or stat.S_IMODE(info.st_mode) & 0o022
                )
            ):
                raise ValueError(
                    f"Active release file path is unsafe for {component_id}: {relative_name}."
                )
        info = payload_path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
            raise ValueError(
                f"Active release file is not root-controlled for {component_id}: {relative_name}."
            )
        actual_digest = "sha256:" + _sha256_file(payload_path)
        if actual_digest != expected_digest:
            raise ValueError(
                f"Active release file digest mismatch for {component_id}: {relative_name}."
            )

    return release, manifest, (release / unit_relative).read_bytes()


def install_missing_component_units(
    module: Any,
    updater: Any,
    *,
    install_root_path: Path = Path("/usr/lib/cyrene"),
    destination: Path = Path("/usr/lib/systemd/system"),
    search_directories: tuple[Path, ...] = (
        Path("/etc/systemd/system"),
        Path("/run/systemd/system"),
        Path("/lib/systemd/system"),
        Path("/usr/lib/systemd/system"),
    ),
) -> tuple[list[str], list[str]]:
    """Install only verified Platform units that are absent from systemd paths."""

    if os.geteuid() != 0:
        raise PermissionError("Installing systemd units requires the root OS identity.")
    platform_publisher = "DoHorizon-AI/Cyrene-Platform"
    installed: list[str] = []
    existing: list[str] = []
    for component in sorted(updater.components.values(), key=lambda item: item["componentId"]):
        component_id = component.get("componentId")
        if (
            component.get("publisher") != platform_publisher
            or component.get("kind") != "native-binary"
            or component_id == "cy-runtime-agent"
            or not component.get("systemdUnit")
            or not any(
                target.get("artifactKind") == "native-binary"
                and target.get("support") == "supported"
                for target in component.get("targets", [])
            )
        ):
            continue
        target = updater._target_for(component)
        if target is None or target.get("artifactKind") != "native-binary":
            continue
        unit = component["systemdUnit"]
        unit_locations = [directory / unit for directory in search_directories]
        existing_locations = [path for path in unit_locations if path.exists() or path.is_symlink()]
        active = install_root_path / "components" / component["componentId"] / "active"
        if not active.exists() and not active.is_symlink():
            if existing_locations:
                raise FileExistsError(
                    f"Existing systemd unit has no active trusted release to verify: {unit}"
                )
            continue
        _, _, unit_bytes = _validate_installed_native_component(
            module, updater, component, install_root_path
        )
        expected_digest = hashlib.sha256(unit_bytes).hexdigest()
        if existing_locations:
            for existing_path in existing_locations:
                if existing_path.is_symlink() or not existing_path.is_file():
                    raise FileExistsError(
                        f"Existing systemd unit is not a regular file: {existing_path}"
                    )
                info = existing_path.lstat()
                if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
                    raise FileExistsError(
                        f"Existing systemd unit is not root-controlled: {existing_path}"
                    )
                if _sha256_file(existing_path) != expected_digest:
                    raise FileExistsError(
                        f"Existing systemd unit conflicts with the trusted payload: {existing_path}"
                    )
            existing.append(unit)
            continue

        destination.mkdir(parents=True, exist_ok=True, mode=0o755)
        destination_info = destination.lstat()
        if (
            not stat.S_ISDIR(destination_info.st_mode)
            or destination.is_symlink()
            or destination_info.st_uid != 0
            or stat.S_IMODE(destination_info.st_mode) & 0o022
        ):
            raise ValueError(
                f"Systemd unit destination is not a root-owned real directory: {destination}"
            )
        target_path = destination / unit
        temporary = destination / f".{unit}.{secrets.token_hex(8)}.tmp"
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        try:
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(unit_bytes)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temporary, 0o644)
            os.link(temporary, target_path, follow_symlinks=False)
            temporary.unlink()
            directory_fd = os.open(destination, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except Exception:
            if temporary.exists() or temporary.is_symlink():
                temporary.unlink()
            raise
        installed.append(unit)
    return installed, existing


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def cmd_component_install_missing_units(args: argparse.Namespace) -> int:
    """Install absent, pinned Platform systemd units without starting services."""

    try:
        module = _load_component_updates_module()
        updater = module.ComponentUpdater()
        installed, existing = install_missing_component_units(module, updater)
        if installed and Path("/run/systemd/system").is_dir():
            reload_result = subprocess.run(
                ["/usr/bin/systemctl", "daemon-reload"], capture_output=True, text=True, check=False
            )
            if reload_result.returncode != 0:
                detail = reload_result.stderr.strip()[:500]
                raise RuntimeError(f"systemctl daemon-reload failed: {detail}")
        print(
            json.dumps({"installed": installed, "alreadyPresent": existing}, separators=(",", ":"))
        )
        return 0
    except Exception as error:  # noqa: BLE001 - report unit validation and installation failures uniformly.
        print(f"ERROR: cannot install trusted component units: {error}", file=sys.stderr)
        return 1


def cmd_upgrade(args: argparse.Namespace) -> int:
    """Keep the legacy command from bypassing the gated update protocol."""

    print(
        "The legacy upgrade command no longer changes service releases. Use `cyrene update --json` "
        "to check, stage, then apply the exact confirmed plan through the runtime maintenance gate.",
        file=sys.stderr,
    )
    if getattr(args, "service", None) == "echo":
        print("Echo has no native Linux Python bundle target.", file=sys.stderr)
    return 2


def cmd_uninstall(args: argparse.Namespace) -> int:
    home = dev_home()
    print("Stopping all Cyrene services...")
    cmd_down(args)

    print("\nCyrene services have been stopped.")
    print(f"Your workspace data and artifacts have been preserved at:\n  {home}")
    print("\nCleanup instructions:")
    print(f"  - To permanently remove all data, execute:\n      rm -rf {home}")
    print("  - If installed via deb package:\n      sudo apt remove cyrene")
    print("  - To delete virtual environments:\n      rm -rf Cyrene-*/.venv")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="cyrene",
        description="Cyrene RC Unified Operations CLI",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # init
    init_parser = subparsers.add_parser(
        "init", help="Initialize Workspace, database, and internal credentials"
    )
    init_parser.set_defaults(func=cmd_init)

    # up
    up_parser = subparsers.add_parser("up", help="Start all Cyrene services")
    up_parser.add_argument("--no-build", action="store_true", help="Skip runtime build steps")
    up_parser.set_defaults(func=cmd_up)

    # down
    down_parser = subparsers.add_parser("down", help="Stop all Cyrene services")
    down_parser.set_defaults(func=cmd_down)

    # status
    status_parser = subparsers.add_parser(
        "status", help="Print status of Product services and GPU info"
    )
    status_parser.set_defaults(func=cmd_status)

    # doctor
    doctor_parser = subparsers.add_parser("doctor", help="Run environment preflight checks")
    doctor_parser.set_defaults(func=cmd_doctor)

    # logs
    logs_parser = subparsers.add_parser(
        "logs", help="Tail service logs, or read one resource's diagnostics"
    )
    logs_parser.add_argument("service", nargs="?", choices=SERVICES_LIST, help="Service name")
    logs_parser.add_argument("-n", "--lines", type=int, default=50, help="Number of lines to show")
    logs_parser.add_argument("-f", "--follow", action="store_true", help="Follow log output")
    logs_parser.add_argument("--run", help="Read a training run's diagnostics by id")
    logs_parser.add_argument("--deployment", help="Read a deployment's diagnostics by id")
    logs_parser.add_argument("--trace", help="Search locally written logs for a trace id")
    logs_parser.add_argument("--json", action="store_true", help="Emit raw diagnostic records")
    logs_parser.set_defaults(func=cmd_logs)

    # diagnostics
    diagnostics_parser = subparsers.add_parser(
        "diagnostics", help="Collect a redacted diagnostics bundle"
    )
    diagnostics_subparsers = diagnostics_parser.add_subparsers(
        dest="diagnostics_command", required=True
    )
    collect_parser = diagnostics_subparsers.add_parser(
        "collect", help="Write versions, correlation ids and logs to one private file"
    )
    collect_parser.add_argument("--run", help="Training run id")
    collect_parser.add_argument("--deployment", help="Deployment id")
    collect_parser.add_argument("--trace", help="Trace id to search for locally")
    collect_parser.add_argument("--output", required=True, help="Destination file (mode 0600)")
    collect_parser.set_defaults(func=cmd_diagnostics_collect)

    # bootstrap
    bootstrap_parser = subparsers.add_parser(
        "bootstrap", help="Install, inspect, or repair the pinned runtime"
    )
    bootstrap_parser.add_argument(
        "--check", action="store_true", help="Report the runtime state without changing it"
    )
    bootstrap_parser.add_argument(
        "--repair", action="store_true", help="Reinstall the pinned runtime"
    )
    bootstrap_parser.set_defaults(func=cmd_bootstrap)

    # model import
    model_parser = subparsers.add_parser("model", help="Manage model imports")
    model_subparsers = model_parser.add_subparsers(dest="model_command", required=True)
    import_parser = model_subparsers.add_parser(
        "import", help="Import a model via HuggingFace or local path"
    )
    import_parser.add_argument("--hf", help="HuggingFace model repository (e.g. org/repo)")
    import_parser.add_argument("--revision", help="HuggingFace model revision SHA or branch")
    import_parser.add_argument("--path", help="Local model directory path")
    import_parser.add_argument("--name", help="Custom model import name")
    import_parser.add_argument(
        "--binding", default="local-gpu", help="Serving binding id (default: local-gpu)"
    )
    import_parser.set_defaults(func=cmd_model_import)

    # backup
    backup_parser = subparsers.add_parser("backup", help="Backup Workspace data directory")
    backup_parser.add_argument(
        "--dest", required=True, help="Destination backup directory or file path"
    )
    backup_parser.set_defaults(func=cmd_backup)

    # restore
    restore_parser = subparsers.add_parser(
        "restore", help="Restore backup into Workspace data directory"
    )
    restore_parser.add_argument("--src", required=True, help="Source backup file or directory")
    restore_parser.set_defaults(func=cmd_restore)

    # systemd invokes one foreground service per unit; users normally manage
    # these commands through systemctl rather than calling them directly.
    service_run_parser = subparsers.add_parser("service-run", help=argparse.SUPPRESS)
    service_run_parser.add_argument("service", choices=SYSTEMD_SERVICES)
    service_run_parser.add_argument("service_args", nargs=argparse.REMAINDER)
    service_run_parser.set_defaults(func=cmd_service_run)

    service_bootstrap_parser = subparsers.add_parser("service-bootstrap", help=argparse.SUPPRESS)
    service_bootstrap_parser.add_argument(
        "--activate-missing",
        action="store_true",
        help="Activate a packaged release only when the service has no active release",
    )
    service_bootstrap_parser.set_defaults(func=cmd_service_bootstrap)

    component_run_parser = subparsers.add_parser("component-run", help=argparse.SUPPRESS)
    component_run_parser.add_argument("component_id", help="Trusted native component ID")
    component_run_parser.add_argument(
        "startup_arguments",
        nargs=argparse.REMAINDER,
        help="Root-owned systemd startup arguments after `--`",
    )
    component_run_parser.set_defaults(func=cmd_component_run)

    component_units_parser = subparsers.add_parser(
        "component-install-missing-units", help=argparse.SUPPRESS
    )
    component_units_parser.set_defaults(func=cmd_component_install_missing_units)

    # update
    update_parser = subparsers.add_parser(
        "update", help="Check, stage, or apply trusted components through the maintenance gate"
    )
    update_parser.add_argument(
        "--json",
        action="store_true",
        required=True,
        help="Use the fixed single-line JSON stdin/stdout helper protocol",
    )
    update_parser.set_defaults(func=cmd_update)

    # upgrade
    upgrade_parser = subparsers.add_parser(
        "upgrade", help="Deprecated compatibility entry point; does not mutate component releases"
    )
    upgrade_parser.add_argument("service", nargs="?", help="Legacy Product service name")
    upgrade_parser.add_argument(
        "--artifact",
        type=Path,
        help="Rejected legacy direct-update option; stage and confirm through cyrene update instead",
    )
    upgrade_parser.set_defaults(func=cmd_upgrade)

    # uninstall
    uninstall_parser = subparsers.add_parser(
        "uninstall", help="Stop services and print cleanup guidance"
    )
    uninstall_parser.set_defaults(func=cmd_uninstall)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
