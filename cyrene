def dev_home() -> Path:
    configured = os.environ.get("CYRENE_DEV_HOME")
    return Path(configured).expanduser().resolve() if configured else DEFAULT_DEV_HOME.resolve()


# A diagnostics bundle holds environment detail, so it is written for the
# invoking user only and never uploaded anywhere.
DIAGNOSTICS_BUNDLE_MODE = 0o600
