def install_root() -> Path:
    configured = os.environ.get("CYRENE_INSTALL_ROOT")
    return Path(configured).expanduser() if configured else Path("/usr/lib/cyrene")


def _product_url(service: str) -> str:
    return f"http://127.0.0.1:{PRODUCT_PORTS[service]}"


def _request_json(url: str, timeout: float = 15.0, headers: dict[str, str] | None = None) -> Any:
    """GET one local Product URL and decode JSON, with a stable failure message."""

    request = urllib.request.Request(
        url, headers={"User-Agent": "CyreneCLI", "Accept": "application/json", **(headers or {})}
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")[:400]
        raise RuntimeError(f"{url} returned HTTP {error.code}: {detail}") from error
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"{url} is unreachable: {error}") from error


def _diagnostics_source(args: argparse.Namespace) -> tuple[str, str] | None:
    """Resolve the requested diagnostics target to (kind, url)."""

    run_id = getattr(args, "run", None)
    deployment_id = getattr(args, "deployment", None)
    if run_id:
        return ("run", f"{_product_url('yield')}/api/v1/training-runs/{run_id}/diagnostics")
    if deployment_id:
        return (
            "deployment",
            f"{_product_url('reactor')}/api/v1/deployments/{deployment_id}/diagnostics",
        )
    return None


def _format_diagnostic(record: dict[str, Any]) -> str:
    timestamp = str(record.get("timestamp", ""))[:19]
    level = str(record.get("level", "info")).upper()
    stream = str(record.get("stream", "combined"))
    code = record.get("code") or record.get("source") or ""
    return f"{timestamp} {level:<5} {stream:<8} {code:<28} {record.get('message', '')}".rstrip()


def _print_diagnostics_page(page: dict[str, Any], *, as_json: bool, lines: int) -> int:
    items = page.get("items") or []
    if as_json:
        for item in items[-lines:] if lines else items:
            print(json.dumps(item, ensure_ascii=False))
    else:
        for item in items[-lines:] if lines else items:
            print(_format_diagnostic(item))
    return int(page.get("nextSequence") or 0)


def _scan_trace(trace_id: str, lines: int) -> int:
    """Search locally written logs for one correlation id.

    Product diagnostics are paged by resource, not by trace, so a trace lookup
    reads the files this host already wrote and says where it looked.
    """

    home = dev_home()
    searched: list[Path] = []
    matches: list[str] = []
    for path in sorted(home.rglob("*")):
        if not path.is_file() or path.suffix not in {".log", ".ndjson"}:
            continue
        searched.append(path)
        try:
            content = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in content.splitlines():
            if trace_id in line:
                matches.append(f"{path.name}: {line}")
    if not matches:
        print(f"No local record of trace {trace_id} in {len(searched)} file(s) under {home}.")
        print("For a complete root cause, collect a bundle by --run or --deployment id.")
        return 1
    for line in matches[-lines:] if lines else matches:
        print(line)
    return 0


def prepare_data_dirs(home: Path) -> None:
    for sub in ("platform", "trainer", "reactor", "services", "logs", "artifacts"):
        (home / sub).mkdir(parents=True, exist_ok=True)
    home.chmod(0o700)


def generate_pair_code() -> str:
    alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    return "".join(secrets.choice(alphabet) for _ in range(6))


def read_pair_credentials(home: Path) -> tuple[str, str | None]:
    pair_code = ""
    issued_at: str | None = None
    code_file = home / "pair_code.txt"
    if code_file.is_file():
        pair_code = code_file.read_text(encoding="utf-8").strip()
    creds_file = home / "credentials.env"
    if creds_file.is_file():
        for line in creds_file.read_text(encoding="utf-8").splitlines():
            k, sep, v = line.partition("=")
            if sep:
                key = k.strip()
                if key == "CYRENE_WEB_HOST_PAIR_CODE" and not pair_code:
                    pair_code = v.strip()
                elif key == "CYRENE_WEB_HOST_PAIR_CODE_ISSUED_AT":
                    issued_at = v.strip()
    return pair_code, issued_at


def read_pair_code(home: Path) -> str:
    code, _ = read_pair_credentials(home)
    return code


def write_credentials(home: Path, pair_code: str) -> None:
    creds_file = home / "credentials.env"
    now_iso = datetime.now(UTC).isoformat()
    creds = {
        "CYRENE_EXCHANGE_TOKEN": secrets.token_urlsafe(32),
        "CYRENE_NAVIGATOR_TOKEN": secrets.token_urlsafe(32),
        "CYRENE_WEB_HOST_PAIR_CODE": pair_code,
        "CYRENE_WEB_HOST_PAIR_CODE_ISSUED_AT": now_iso,
    }
    if creds_file.is_file():
        for line in creds_file.read_text(encoding="utf-8").splitlines():
            k, sep, v = line.partition("=")
            if sep and k.strip():
                creds[k.strip()] = v.strip()
        creds["CYRENE_WEB_HOST_PAIR_CODE"] = pair_code
        creds["CYRENE_WEB_HOST_PAIR_CODE_ISSUED_AT"] = now_iso

    fd = os.open(creds_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        for k, v in creds.items():
            f.write(f"{k}={v}\n")

    code_file = home / "pair_code.txt"
    fd_code = os.open(code_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd_code, "w", encoding="utf-8") as f:
        f.write(f"{pair_code}\n")


def cmd_init(args: argparse.Namespace) -> int:
    home = dev_home()
    prepare_data_dirs(home)
    pair_code = generate_pair_code()
    write_credentials(home, pair_code)
    print(f"CYRENE PAIR CODE: {pair_code}")
    return 0


def _locate_web_host_launcher() -> Path | None:
    """Locate serve-web.py for either a Navigator checkout or a packaged install."""

    candidates = [
        WORKSPACE_ROOT / "scripts" / "serve-web.py",
        CYRENE_ROOT / "Cyrene-Navigator" / "scripts" / "serve-web.py",
        CYRENE_ROOT / "Cyrene-Services" / "Cyrene-Navigator" / "scripts" / "serve-web.py",
        Path("/usr/lib/cyrene/scripts/serve-web.py"),
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def _running_under_systemd() -> bool:
    """True when systemd itself invoked this process (i.e. from a unit)."""

    return bool(os.environ.get("INVOCATION_ID") or os.environ.get("JOURNAL_STREAM"))


def _start_units_with_systemd() -> bool:
    """Start the packaged Product units when systemd actually owns them."""

    if not Path("/run/systemd/system").exists() or shutil.which("systemctl") is None:
        return False
    probe = subprocess.run(
        ["systemctl", "list-unit-files", *[f"{unit}.service" for unit in SYSTEMD_UNITS]],
        capture_output=True,
        text=True,
        check=False,
    )
    if probe.returncode != 0:
        return False
    installed = [unit for unit in SYSTEMD_UNITS if f"{unit}.service" in probe.stdout]
    if not installed:
        return False
    started = subprocess.run(["systemctl", "start", *installed], check=False)
    if started.returncode != 0:
        return False
    print(f"Started {len(installed)} Cyrene unit(s) via systemd.")
    return True


def _web_host_command(launcher: Path) -> list[str]:
    """Prefer the project's uv environment; fall back to this interpreter.

    The Web Host needs its own dependencies, which `python3` alone usually does
    not have. A packaged install keeps them under /usr/lib/cyrene, so the same
    rule works for both layouts.
    """

    project_root = launcher.parent.parent
    if (project_root / "pyproject.toml").is_file() and shutil.which("uv") is not None:
        return ["uv", "run", "--project", str(project_root), "python", str(launcher)]
    return [sys.executable, str(launcher)]


def _start_web_host(home: Path, env: dict[str, str], pair_code: str) -> int | None:
    """Start the Web Host detached so `cyrene up` does not hold the terminal."""

    launcher = _locate_web_host_launcher()
    if launcher is None:
        print("[WARN] Navigator Web Host launcher (serve-web.py) was not found.")
        print("       Products are up but the console API is unreachable.")
        return None

    logs_dir = home / "logs"
    logs_dir.mkdir(parents=True, exist_ok=True)
    argv = [
        *_web_host_command(launcher),
        "--host",
        os.environ.get("CYRENE_WEB_HOST_HOST", "127.0.0.1"),
        "--port",
        str(WEB_HOST_PORT),
        "--pairing-code",
        pair_code,
    ]
    for product, port in PRODUCT_PORTS.items():
        argv += ["--proxy", f"/api/v1/{product}=http://127.0.0.1:{port}"]
    # A same-host HTTP console cannot set Secure cookies; suppress only that.
    argv.append("--insecure-http")

    try:
        log_handle = (logs_dir / "navigator-web-host.log").open("ab")
        try:
            process = subprocess.Popen(
                argv,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        finally:
            log_handle.close()
    except OSError as error:
        print(f"[WARN] Could not start Navigator Web Host: {error}")
        return None
    return process.pid


def cmd_up(args: argparse.Namespace) -> int:
    home = dev_home()
    prepare_data_dirs(home)
    pair_code, issued_at = read_pair_credentials(home)
    if not pair_code:
        pair_code = generate_pair_code()
        write_credentials(home, pair_code)
        _, issued_at = read_pair_credentials(home)

    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)
    env["CYRENE_WEB_HOST_PAIR_CODE"] = pair_code
    if issued_at:
        env["CYRENE_WEB_HOST_PAIR_CODE_ISSUED_AT"] = issued_at

    # A packaged install is supervised by systemd; only fall back to launching
    # the development stack ourselves when systemd does not own the units.
    # When systemd invokes us it expects a foreground process, so we must never
    # hand control back to systemctl from inside a unit (the navigator unit
    # runs `cyrene up` and would otherwise exit immediately).
    if not _running_under_systemd() and _start_units_with_systemd():
        print(f"Navigator console ready: http://127.0.0.1:{WEB_HOST_PORT}")
        return 0

    cmd = [sys.executable, str(DEV_SCRIPT), "up"]
    if getattr(args, "no_build", False):
        cmd.append("--no-build")
    returncode = subprocess.run(cmd, env=env, check=False).returncode
    if returncode != 0:
        return returncode

    pid = _start_web_host(home, env, pair_code)
    if pid is None:
        return 0
    print(f"Navigator console ready: http://127.0.0.1:{WEB_HOST_PORT} (pair code: {pair_code})")
    print(f"Web Host PID {pid}; see {home / 'logs' / 'navigator-web-host.log'} for its output.")
    return 0


def cmd_down(args: argparse.Namespace) -> int:
    home = dev_home()
    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)
    return subprocess.run(
        [sys.executable, str(DEV_SCRIPT), "down"], env=env, check=False
    ).returncode


def get_gpu_info() -> list[dict[str, str]]:
    try:
        out = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=name,memory.total,memory.used,utilization.gpu",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        if out.returncode != 0 or not out.stdout.strip():
            return []
        gpus = []
        for line in out.stdout.strip().splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 4:
                gpus.append(
                    {
                        "name": parts[0],
                        "memory_total": parts[1],
                        "memory_used": parts[2],
                        "utilization": parts[3],
                    }
                )
        return gpus
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return []


def cmd_status(args: argparse.Namespace) -> int:
    home = dev_home()
    env = os.environ.copy()
    env["CYRENE_DEV_HOME"] = str(home)
    env["CYRENE_RUNTIME_HOME"] = str(home)

    print("=== Cyrene Services Status ===")
    dev_res = subprocess.run(
        [sys.executable, str(DEV_SCRIPT), "status"], env=env, check=False
    ).returncode

    print("\n=== GPU Information ===")
    gpus = get_gpu_info()
    if not gpus:
        print("No GPU detected or nvidia-smi unavailable.")
    else:
        for i, g in enumerate(gpus):
            print(
                f"GPU {i}: {g['name']} | "
                f"Memory: {g['memory_used']} / {g['memory_total']} MiB | "
                f"Utilization: {g['utilization']}%"
            )
    return dev_res


def check_port_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def python_module_version(module_name: str) -> str | None:
    """Installed version of `module_name`, or None when it is not importable.

    Probing the current interpreter is deliberate: `cmd_up` launches Products
    through `sys.executable`, so a package missing here is missing for them too.
    """
    if importlib.util.find_spec(module_name) is None:
        return None
    try:
        return importlib.metadata.version(module_name)
    except importlib.metadata.PackageNotFoundError:
        return "present (version metadata unavailable)"


def git_head(repo_path: Path) -> str | None:
    """Current HEAD revision of a checkout, or None when it cannot be read."""
    try:
        out = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.strip() or None


def cmd_doctor(args: argparse.Namespace) -> int:
    home = dev_home()
    all_passed = True
    print("┌─────────────────────────────────────────────────────────────┐")
    print("│                 Cyrene Environment Preflight                │")
    print("└─────────────────────────────────────────────────────────────┘")

    # 1. Python version >= 3.11
    py_ver = sys.version_info
    py_str = f"{py_ver.major}.{py_ver.minor}.{py_ver.micro}"
    if py_ver >= (3, 11):
        print(f"[OK] Python version: {py_str} (>= 3.11)")
    else:
        print(f"[FAIL] Python version: {py_str} (must be >= 3.11)")
        all_passed = False

    # 2. nvidia-smi & GPU VRAM
    gpus = get_gpu_info()
    if not gpus:
        print("[FAIL] NVIDIA driver: nvidia-smi failed or no GPU found")
        all_passed = False
    else:
        total_vram_mib = 0
        has_12g = False
        for g in gpus:
            try:
                vram = float(g["memory_total"])
                total_vram_mib += vram
                if vram >= 12000 or round(vram / 1024) >= 12:  # Nominal 12 GiB
                    has_12g = True
            except ValueError:
                pass
        if has_12g:
            print(f"[OK] GPU: {len(gpus)} detected, with >= 12 GiB VRAM ({gpus[0]['name']})")
        else:
            print(
                f"[FAIL] GPU: {len(gpus)} detected, but requires at least 1 GPU with >= 12 GiB VRAM"
            )
            all_passed = False

    # 3. CUDA check
    cuda_found = False
    cuda_ver = "unknown"
    try:
        out = subprocess.run(
            ["nvcc", "--version"],
            capture_output=True,
            text=True,
            check=False,
            timeout=5,
        )
        if out.returncode == 0:
            cuda_found = True
            for line in out.stdout.splitlines():
                if "release" in line:
                    cuda_ver = line.strip()
    except (FileNotFoundError, OSError):
        pass
    if not cuda_found:
        if Path("/usr/local/cuda").exists():
            cuda_found = True
            cuda_ver = "installed at /usr/local/cuda"
        elif gpus:
            cuda_found = True
            cuda_ver = "CUDA driver available via nvidia-smi"
    if cuda_found:
        print(f"[OK] CUDA: Available ({cuda_ver})")
    else:
        print("[WARN] CUDA: nvcc / CUDA toolkit not found in standard paths")

    # 4. Free disk >= 50 GiB
    try:
        usage = shutil.disk_usage(home if home.exists() else "/")
        free_gib = usage.free / (1024**3)
        if free_gib >= 50.0:
            print(f"[OK] Disk space: {free_gib:.1f} GiB free (>= 50 GiB required)")
        else:
            print(f"[FAIL] Disk space: {free_gib:.1f} GiB free (requires >= 50 GiB)")
            all_passed = False
    except OSError as e:
        print(f"[FAIL] Disk space check failed: {e}")
        all_passed = False

    # 5. Training and serving engines.
    # These used to be assumed present, so doctor reported a clean bill of
    # health on hosts that could neither train nor serve. They must be
    # resolvable to a version because release-lock.json pins exact ones.
    for module, purpose in REQUIRED_PYTHON_MODULES.items():
        version = python_module_version(module)
        if version is None:
            print(f"[FAIL] {module}: not installed — {purpose}")
            all_passed = False
        else:
            print(f"[OK] {module}: {version}")

    # 6. release-lock.json pins vs the revisions actually checked out.
    # A mismatch only warns: it means you are running a different revision than
    # the RC declares, which is legitimate during development but must not be
    # silent when shipping acceptance evidence.
    lock_path = WORKSPACE_ROOT / "release-lock.json"
    try:
        lock = json.loads(lock_path.read_text(encoding="utf-8"))
        pinned_repositories = lock.get("repositories", {})
        if not pinned_repositories:
            print("[WARN] release-lock.json declares no 'repositories' pins to verify")
        else:
            checked_out = 0
            mismatched = 0
            for repo, expected in sorted(pinned_repositories.items()):
                repo_path = CYRENE_ROOT / repo
                # A developer checkout is usually partial; absent repos are
                # reported as skipped rather than as a mismatch.
                if not (repo_path / ".git").exists():
                    continue
                checked_out += 1
                actual = git_head(repo_path)
                if actual is None:
                    print(f"[WARN] Lock SHA unreadable: {repo} (cannot read git HEAD)")
                elif actual != expected:
                    mismatched += 1
                    print(
                        f"[WARN] Lock SHA mismatch: {repo} "
                        f"(lock: {expected[:8]}, current: {actual[:8]})"
                    )
            if checked_out == 0:
                print("[SKIP] Lock SHA: no pinned repositories are checked out locally")
            elif mismatched == 0:
                noun = "repository" if checked_out == 1 else "repositories"
                print(f"[OK] Lock SHA: {checked_out} checked-out {noun} match release-lock.json")
    except FileNotFoundError:
        print(f"[WARN] release-lock.json not found at {lock_path}")
    except (OSError, json.JSONDecodeError) as e:
        print(f"[WARN] release-lock.json could not be verified: {e}")

    # 7. systemd or proc available
    has_systemd_or_proc = (
        Path("/run/systemd/system").exists()
        or Path("/proc").exists()
        or shutil.which("systemctl") is not None
    )
    if has_systemd_or_proc:
        print("[OK] Process supervisor: Linux /proc or systemd available")
    else:
        print("[FAIL] Neither systemd nor /proc is available")
        all_passed = False

    # 8. Check required ports
    for label, port in DEFAULT_PORTS.items():
        if check_port_free(port):
            print(f"[OK] Port {label}: available")
        else:
            print(f"[WARN] Port {label}: occupied or in use")

    # 9. Check Product services health if running
    pids_file = home / "pids.json"
    if pids_file.is_file():
        print("\n--- Running Services Health Check ---")
        try:
            pids = json.loads(pids_file.read_text(encoding="utf-8"))
            for name, pid in pids.items():
                try:
                    os.kill(int(pid), 0)
                    print(f"[OK] Service '{name}' (PID {pid}): process active")
                except ProcessLookupError:
                    print(f"[FAIL] Service '{name}' (PID {pid}): process died")
                    all_passed = False
        except (OSError, json.JSONDecodeError):
            pass

    print("─────────────────────────────────────────────────────────────")
    if all_passed:
        print("Doctor assessment: ALL SYSTEM CHECKS PASSED.")
        return 0
    else:
        print("Doctor assessment: ISSUES FOUND. Resolve blockers before running cyrene up.")
        return 1


def cmd_logs(args: argparse.Namespace) -> int:
    source = _diagnostics_source(args)
    trace_id = getattr(args, "trace", None)
    if source is not None:
        return _logs_from_diagnostics(source, args)
    if trace_id:
        return _scan_trace(trace_id, getattr(args, "lines", 50))

    home = dev_home()
    logs_dir = home / "logs"
    if not logs_dir.is_dir():
        print(f"No logs directory found at {logs_dir}")
        return 1

    service = getattr(args, "service", None)
    if not service:
        print("Available log files in logs directory:")
        for log_file in sorted(logs_dir.glob("*.log")):
            print(f"  - {log_file.name}")
        return 0

    candidates = [
        logs_dir / f"{service}.stdout.log",
        logs_dir / f"{service}.stderr.log",
        logs_dir / f"{service}-control.stdout.log",
        logs_dir / f"{service}-control.stderr.log",
    ]
    target_files = [f for f in candidates if f.is_file()]
    if not target_files:
        matching = list(logs_dir.glob(f"*{service}*.log"))
        target_files = matching

    if not target_files:
        print(f"No log files found for service '{service}' in {logs_dir}")
        return 1

    lines = getattr(args, "lines", 50)
    for tf in target_files:
        print(f"\n=== {tf.name} (last {lines} lines) ===")
        try:
            all_lines = tf.read_text(encoding="utf-8", errors="replace").splitlines()
            for line in all_lines[-lines:]:
                print(line)
        except OSError as e:
            print(f"Error reading {tf}: {e}")

    if getattr(args, "follow", False) and target_files:
        main_target = target_files[0]
        print(f"\n--- Following {main_target.name} (Ctrl+C to stop) ---")
        try:
            with main_target.open("r", encoding="utf-8", errors="replace") as f:
                f.seek(0, os.SEEK_END)
                while True:
                    line = f.readline()
                    if line:
                        sys.stdout.write(line)
                        sys.stdout.flush()
                    else:
                        time.sleep(0.5)
        except KeyboardInterrupt:
            return 0
    return 0


def _logs_from_diagnostics(source: tuple[str, str], args: argparse.Namespace) -> int:
    """Print one resource's diagnostics, optionally following until terminal."""

    kind, url = source
    lines = getattr(args, "lines", 50)
    as_json = bool(getattr(args, "json", False))
    follow = bool(getattr(args, "follow", False))
    cursor = 0
    try:
        while True:
            page = _request_json(f"{url}?afterSequence={cursor}&limit={DIAGNOSTICS_PAGE_LIMIT}")
            cursor = _print_diagnostics_page(page, as_json=as_json, lines=lines)
            if not follow or page.get("terminal"):
                if page.get("diagnostics_degraded") or page.get("diagnosticsDegraded"):
                    print(
                        f"WARNING: {kind} diagnostics are degraded; some output was lost.",
                        file=sys.stderr,
                    )
                break
            lines = 0  # only the first page is tailed; later pages print in full
            time.sleep(0.5)
    except RuntimeError as error:
        print(f"ERROR: {error}")
        return 1
    except KeyboardInterrupt:
        return 0
    return 0


def cmd_diagnostics_collect(args: argparse.Namespace) -> int:
    """Write a redacted diagnostics bundle for one resource to a private file."""

    source = _diagnostics_source(args)
    trace_id = getattr(args, "trace", None)
    output = Path(args.output).expanduser()
    bundle: dict[str, Any] = {
        "generatedAt": datetime.now(UTC).isoformat(),
        "tool": "cyrene",
        "correlation": {},
        "versions": _version_manifest(),
        "diagnostics": [],
        "resource": None,
        "cleanup": {"confirmed": False, "detail": "resource state was not read"},
    }

    exit_code = 0
    if source is not None:
        kind, url = source
        cursor = 0
        items: list[dict[str, Any]] = []
        try:
            while True:
                page = _request_json(f"{url}?afterSequence={cursor}&limit={DIAGNOSTICS_PAGE_LIMIT}")
                items.extend(page.get("items") or [])
                next_cursor = int(page.get("nextSequence") or cursor)
                terminal = bool(page.get("terminal"))
                degraded = bool(page.get("diagnostics_degraded") or page.get("diagnosticsDegraded"))
                if next_cursor == cursor or terminal:
                    break
                cursor = next_cursor
        except RuntimeError as error:
            print(f"ERROR: {error}")
            return 1
        bundle["correlation"][kind] = url.split("/")[-2]
        bundle["diagnostics"] = items
        bundle["cleanup"] = {
            "confirmed": terminal,
            "detail": "terminal state reached" if terminal else "resource is still running",
        }
        bundle["diagnosticsDegraded"] = degraded
    elif trace_id:
        bundle["correlation"]["trace"] = trace_id
        home = dev_home()
        matches = []
        for path in sorted(home.rglob("*")):
            if not path.is_file() or path.suffix not in {".log", ".ndjson"}:
                continue
            try:
                content = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            matches.extend(line for line in content.splitlines() if trace_id in line)
        bundle["diagnostics"] = [{"source": "local_file", "message": line} for line in matches]
        bundle["cleanup"] = {
            "confirmed": False,
            "detail": f"trace lookup searched {home} without a resource identity",
        }
        if not matches:
            exit_code = 1
    else:
        print("ERROR: pass exactly one of --run, --deployment or --trace")
        return 2

    try:
        _write_private_json(output, bundle)
    except OSError as error:
        print(f"ERROR: could not write {output}: {error}")
        return 1
    print(f"Wrote {output} (mode 0600). It is not uploaded anywhere.")
    if exit_code:
        print("No matching records were found; the bundle records where it looked.")
    return exit_code


def _version_manifest() -> dict[str, Any]:
    """Collect the pinned versions and repository revisions in force."""

    manifest: dict[str, Any] = {"releaseLock": None, "engines": {}, "repositories": {}}
    lock_path = WORKSPACE_ROOT / "release-lock.json"
    if not lock_path.is_file():
        return manifest
    try:
        document = json.loads(lock_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        manifest["releaseLock"] = "unreadable"
        return manifest
    manifest["releaseLock"] = str(lock_path)
    for entry in (document.get("engines") or {}).values():
        if isinstance(entry, dict) and entry.get("package"):
            manifest["engines"][entry["package"]] = entry.get("acceptedVersion") or entry.get(
                "version"
            )
    for name, revision in (document.get("repositories") or {}).items():
        manifest["repositories"][name] = revision
    return manifest


def _write_private_json(path: Path, document: dict[str, Any]) -> None:
    """Write JSON readable only by the owner, creating parents as needed."""

    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, DIAGNOSTICS_BUNDLE_MODE)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        json.dump(document, stream, ensure_ascii=False, indent=2, sort_keys=True)
        stream.write("\n")
    os.chmod(path, DIAGNOSTICS_BUNDLE_MODE)


def cmd_bootstrap(args: argparse.Namespace) -> int:
    """Install, inspect, or repair the pinned training and serving runtime."""

    root = install_root()
    if getattr(args, "check", False):
        return _bootstrap_check(root)
    script = root / "bootstrap.sh"
    if not script.is_file():
        workspace_script = WORKSPACE_ROOT / "packaging" / "bootstrap.sh"
        if not workspace_script.is_file():
            print(f"ERROR: no bootstrap script found at {script} or {workspace_script}")
            return 1
        script = workspace_script
    action = "Repairing" if getattr(args, "repair", False) else "Installing"
    print(f"{action} the pinned runtime into {root} ...")
    environment = dict(os.environ)
    environment["INSTALL_ROOT"] = str(root)
    completed = subprocess.run([str(script)], env=environment, check=False)
    if completed.returncode != 0:
        print("ERROR: the runtime was not installed; the previous runtime is unchanged.")
        return completed.returncode
    print("Runtime installed. Run 'cyrene doctor' to verify it.")
    return 0


def _bootstrap_check(root: Path) -> int:
    """Report whether the pinned runtime is installed and complete."""

    all_passed = True
    lock_path = root / "release-lock.json"
    if lock_path.is_file():
        print(f"[OK] Release lock: {lock_path}")
    else:
        workspace_lock = WORKSPACE_ROOT / "release-lock.json"
        lock_path = workspace_lock if workspace_lock.is_file() else lock_path
        if lock_path.is_file():
            print(f"[OK] Release lock: {lock_path}")
        else:
            print("[FAIL] No release-lock.json found; engine pins are unknown")
            all_passed = False

    marker = root / BOOTSTRAP_STATE_FILE
    if marker.is_file():
        try:
            document = json.loads(marker.read_text(encoding="utf-8"))
            print(f"[OK] Bootstrap: {document.get('state', 'UNKNOWN')}")
        except (OSError, json.JSONDecodeError):
            print(f"[FAIL] Bootstrap marker at {marker} is unreadable")
            all_passed = False
    else:
        print(f"[FAIL] No bootstrap marker at {marker}; the runtime is not installed")
        all_passed = False

    venv_python = root / RUNTIME_VENV_DIR / "bin" / "python"
    if not venv_python.is_file():
        print(f"[FAIL] Runtime interpreter missing at {venv_python}")
        print("Bootstrap assessment: ISSUES FOUND.")
        return 1
    print(f"[OK] Runtime interpreter: {venv_python}")

    reporter = (
        "import importlib.metadata as m\n"
        "for name in ('vllm', 'llamafactory'):\n"
        "    try:\n"
        "        print(name, m.version(name))\n"
        "    except m.PackageNotFoundError:\n"
        "        print(name, 'MISSING')\n"
    )
    completed = subprocess.run(
        [str(venv_python), "-c", reporter], capture_output=True, text=True, check=False
    )
    if completed.returncode != 0:
        print(f"[FAIL] Runtime engines could not be inspected: {completed.stderr.strip()[:200]}")
        return 1
    for line in completed.stdout.strip().splitlines():
        name, _, version = line.partition(" ")
        if version == "MISSING":
            print(f"[FAIL] {name}: not installed in the runtime environment")
            all_passed = False
        else:
            print(f"[OK] {name}: {version}")

    print("Bootstrap assessment: READY." if all_passed else "Bootstrap assessment: ISSUES FOUND.")
    return 0 if all_passed else 1


def cmd_model_import(args: argparse.Namespace) -> int:
    reactor_url = os.environ.get("CYRENE_REACTOR_URL", "http://127.0.0.1:19300")
    endpoint = f"{reactor_url.rstrip('/')}/api/v1/model-imports"

    if args.hf:
        source = {
            "kind": "HUGGING_FACE",
            "repository": args.hf,
        }
        if args.revision:
            source["revision"] = args.revision
        default_name = args.hf.split("/")[-1]
    elif args.path:
        local_path = str(Path(args.path).resolve())
        if not Path(local_path).exists():
            print(f"Error: Local path does not exist: {local_path}", file=sys.stderr)
            return 1
        source = {
            "kind": "LOCAL_PATH",
            "path": local_path,
        }
        default_name = Path(local_path).name
    else:
        print("Error: Specify either --hf <repo> or --path <local_dir>", file=sys.stderr)
        return 1

    name = args.name or default_name
    binding_id = args.binding or "local-gpu"
    payload = {
        "name": name,
        "serving_binding_id": binding_id,
        "source": source,
        "trust_remote_code": False,
    }

    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Idempotency-Key": f"cli-import-{secrets.token_hex(8)}",
        },
        method="POST",
    )
    print(f"Sending model import request to Reactor ({endpoint})...")
    try:
        with urllib.request.urlopen(req, timeout=30.0) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            print("Model import initiated successfully:")
            print(json.dumps(data, indent=2))
            return 0
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        print(f"Error from Reactor ({e.code}): {body}", file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(f"Failed to connect to Reactor at {reactor_url}: {e.reason}", file=sys.stderr)
        print("Ensure Cyrene services are running (`cyrene up`).", file=sys.stderr)
        return 1


def cmd_backup(args: argparse.Namespace) -> int:
    home = dev_home()
    if not home.is_dir():
        print(f"Data directory does not exist: {home}", file=sys.stderr)
        return 1

    dest = Path(args.dest).resolve()
    if dest.is_dir() or str(args.dest).endswith("/"):
        timestamp = time.strftime("%Y%m%d-%H%M%S")
        target_archive = dest / f"cyrene-backup-{timestamp}.tar.gz"
    else:
        target_archive = dest

    if target_archive == home or target_archive.is_relative_to(home):
        print(
            f"Backup destination must be outside the data directory: {target_archive}",
            file=sys.stderr,
        )
        return 1

    target_archive.parent.mkdir(parents=True, exist_ok=True)
    temporary_archive = target_archive.with_name(
        f".{target_archive.name}.{secrets.token_hex(8)}.tmp"
    )
    print(f"Creating backup from {home} to {target_archive}...")
    try:
        with tarfile.open(temporary_archive, "w:gz") as tar:
            tar.add(home, arcname="cyrene-dev")
        os.replace(temporary_archive, target_archive)
    except (OSError, tarfile.TarError) as exc:
        temporary_archive.unlink(missing_ok=True)
        print(f"Backup failed without replacing the destination: {exc}", file=sys.stderr)
        return 1

    size_mb = target_archive.stat().st_size / (1024 * 1024)
    print(f"Backup completed successfully ({size_mb:.2f} MiB): {target_archive}")
    return 0


def _validate_backup_members(members: list[tarfile.TarInfo]) -> None:
    if not members:
        raise ValueError("backup archive is empty")
    for member in members:
        name = member.name
        path = PurePosixPath(name)
        if (
            not name
            or "\\" in name
            or path.is_absolute()
            or ".." in path.parts
            or not path.parts
            or path.parts[0] != "cyrene-dev"
        ):
            raise ValueError(f"backup member escapes the cyrene-dev root: {name!r}")


def _stage_restore_source(src: Path, staging_root: Path) -> Path:
    staged_home = staging_root / "cyrene-dev"
    if tarfile.is_tarfile(src):
        with tarfile.open(src, "r:*") as archive:
            members = archive.getmembers()
            _validate_backup_members(members)
            archive.extractall(path=staging_root, members=members, filter="data")
    elif src.is_dir():
        source_home = src / "cyrene-dev" if (src / "cyrene-dev").is_dir() else src
        shutil.copytree(source_home, staged_home, symlinks=True)
    else:
        raise ValueError(f"unsupported backup format: {src}")

    if not staged_home.is_dir() or staged_home.is_symlink():
        raise ValueError("backup must contain a real cyrene-dev directory")
    return staged_home


def _replace_home(staged_home: Path, home: Path) -> None:
    previous_home = home.parent / f".{home.name}.restore-previous-{secrets.token_hex(8)}"
    moved_previous = False
    try:
        if home.exists():
            os.replace(home, previous_home)
            moved_previous = True
        os.replace(staged_home, home)
    except OSError as replace_error:
        if moved_previous and previous_home.exists() and not home.exists():
            try:
                os.replace(previous_home, home)
            except OSError as rollback_error:
                raise OSError(
                    f"restore replacement failed ({replace_error}); rollback also failed "
                    f"({rollback_error}); previous data remains at {previous_home}"
                ) from rollback_error
        raise
    if moved_previous:
        try:
            shutil.rmtree(previous_home)
        except OSError as exc:
            print(
                f"Warning: restored data, but could not remove {previous_home}: {exc}",
                file=sys.stderr,
            )
    home.chmod(0o700)


def cmd_restore(args: argparse.Namespace) -> int:
    src = Path(args.src).resolve()
    if not src.exists():
        print(f"Backup source does not exist: {src}", file=sys.stderr)
        return 1

    home = dev_home()
    if home.exists() and not home.is_dir():
        print(f"Data path is not a directory: {home}", file=sys.stderr)
        return 1
    if src == home or src.is_relative_to(home) or home.is_relative_to(src):
        print(
            "Backup source and data directory must not contain one another.",
            file=sys.stderr,
        )
        return 1

    pids_file = home / "pids.json"
    if pids_file.is_file():
        print("Warning: Cyrene services appear to be active. Stopping services before restore...")
        if cmd_down(args) != 0:
            print("Restore aborted because Cyrene services could not be stopped.", file=sys.stderr)
            return 1

    print(f"Restoring backup from {src} to {home}...")
    home.parent.mkdir(parents=True, exist_ok=True)
    try:
        with tempfile.TemporaryDirectory(prefix=".cyrene-restore-", dir=home.parent) as staging:
            staged_home = _stage_restore_source(src, Path(staging))
            _replace_home(staged_home, home)
    except (OSError, tarfile.TarError, ValueError) as exc:
        print(f"Restore failed; the existing data directory was preserved: {exc}", file=sys.stderr)
        return 1

    print("Restore completed successfully.")
    return 0


def cmd_upgrade(args: argparse.Namespace) -> int:
    print("Automatic upgrade is not currently supported.")
    print("To upgrade Cyrene:")
    print("  1. Pull the latest release repository: git pull")
    print("  2. If using deb packaging: sudo apt install ./cyrene_<version>_amd64.deb")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    home = dev_home()
    print("Stopping all Cyrene services...")
    cmd_down(args)

    print("\nCyrene services have been stopped.")
    print(f"Your workspace data and artifacts have been preserved at:\n  {home}")
    print("\nCleanup instructions:")
    print(f"  - To permanently remove all data, execute:\n      rm -rf {home}")
    print("  - If installed via deb package:\n      sudo apt remove cyrene")
    print("  - To delete virtual environments:\n      rm -rf Cyrene-*/.venv")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="cyrene",
        description="Cyrene RC Unified Operations CLI",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # init
    init_parser = subparsers.add_parser(
        "init", help="Initialize Workspace, database, and internal credentials"
    )
    init_parser.set_defaults(func=cmd_init)

    # up
    up_parser = subparsers.add_parser("up", help="Start all Cyrene services")
    up_parser.add_argument("--no-build", action="store_true", help="Skip runtime build steps")
    up_parser.set_defaults(func=cmd_up)

    # down
    down_parser = subparsers.add_parser("down", help="Stop all Cyrene services")
    down_parser.set_defaults(func=cmd_down)

    # status
    status_parser = subparsers.add_parser(
        "status", help="Print status of Product services and GPU info"
    )
    status_parser.set_defaults(func=cmd_status)

    # doctor
    doctor_parser = subparsers.add_parser("doctor", help="Run environment preflight checks")
    doctor_parser.set_defaults(func=cmd_doctor)

    # logs
    logs_parser = subparsers.add_parser(
        "logs", help="Tail service logs, or read one resource's diagnostics"
    )
    logs_parser.add_argument("service", nargs="?", choices=SERVICES_LIST, help="Service name")
    logs_parser.add_argument("-n", "--lines", type=int, default=50, help="Number of lines to show")
    logs_parser.add_argument("-f", "--follow", action="store_true", help="Follow log output")
    logs_parser.add_argument("--run", help="Read a training run's diagnostics by id")
    logs_parser.add_argument("--deployment", help="Read a deployment's diagnostics by id")
    logs_parser.add_argument("--trace", help="Search locally written logs for a trace id")
    logs_parser.add_argument("--json", action="store_true", help="Emit raw diagnostic records")
    logs_parser.set_defaults(func=cmd_logs)

    # diagnostics
    diagnostics_parser = subparsers.add_parser(
        "diagnostics", help="Collect a redacted diagnostics bundle"
    )
    diagnostics_subparsers = diagnostics_parser.add_subparsers(
        dest="diagnostics_command", required=True
    )
    collect_parser = diagnostics_subparsers.add_parser(
        "collect", help="Write versions, correlation ids and logs to one private file"
    )
    collect_parser.add_argument("--run", help="Training run id")
    collect_parser.add_argument("--deployment", help="Deployment id")
    collect_parser.add_argument("--trace", help="Trace id to search for locally")
    collect_parser.add_argument("--output", required=True, help="Destination file (mode 0600)")
    collect_parser.set_defaults(func=cmd_diagnostics_collect)

    # bootstrap
    bootstrap_parser = subparsers.add_parser(
        "bootstrap", help="Install, inspect, or repair the pinned runtime"
    )
    bootstrap_parser.add_argument(
        "--check", action="store_true", help="Report the runtime state without changing it"
    )
    bootstrap_parser.add_argument(
        "--repair", action="store_true", help="Reinstall the pinned runtime"
    )
    bootstrap_parser.set_defaults(func=cmd_bootstrap)

    # model import
    model_parser = subparsers.add_parser("model", help="Manage model imports")
    model_subparsers = model_parser.add_subparsers(dest="model_command", required=True)
    import_parser = model_subparsers.add_parser(
        "import", help="Import a model via HuggingFace or local path"
    )
    import_parser.add_argument("--hf", help="HuggingFace model repository (e.g. org/repo)")
    import_parser.add_argument("--revision", help="HuggingFace model revision SHA or branch")
    import_parser.add_argument("--path", help="Local model directory path")
    import_parser.add_argument("--name", help="Custom model import name")
    import_parser.add_argument(
        "--binding", default="local-gpu", help="Serving binding id (default: local-gpu)"
    )
    import_parser.set_defaults(func=cmd_model_import)

    # backup
    backup_parser = subparsers.add_parser("backup", help="Backup Workspace data directory")
    backup_parser.add_argument(
        "--dest", required=True, help="Destination backup directory or file path"
    )
    backup_parser.set_defaults(func=cmd_backup)

    # restore
    restore_parser = subparsers.add_parser(
        "restore", help="Restore backup into Workspace data directory"
    )
    restore_parser.add_argument("--src", required=True, help="Source backup file or directory")
    restore_parser.set_defaults(func=cmd_restore)

    # upgrade
    upgrade_parser = subparsers.add_parser("upgrade", help="Check or perform stack upgrade")
    upgrade_parser.set_defaults(func=cmd_upgrade)

    # uninstall
    uninstall_parser = subparsers.add_parser(
        "uninstall", help="Stop services and print cleanup guidance"
    )
    uninstall_parser.set_defaults(func=cmd_uninstall)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
