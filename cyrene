def _locate_workspace_root() -> Path:
    """Locate the Workspace root for both a dev checkout and a packaged install.

    The deb package installs this script to /usr/lib/cyrene/scripts/cyrene (with
    /usr/bin/cyrene a symlink), while a checkout keeps it beside
    release-lock.json. Falling back to the script's own directory rather than
    raising keeps the CLI usable when no release lock is present.
    """
    self_path = Path(__file__).resolve()
    parent = self_path.parent
    # Packaged install: /usr/lib/cyrene/scripts/cyrene -> /usr/lib/cyrene
    if parent.name == "scripts":
        return parent.parent
    for candidate in self_path.parents:
        if (candidate / "release-lock.json").exists():
            return candidate
    return parent


