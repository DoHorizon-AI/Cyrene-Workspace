<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <StartupObject>Cyrene.Phase7.HostDriver.DriverMain</StartupObject>
  </PropertyGroup>

  <Target Name="RequireAstrBotRoot" BeforeTargets="Restore">
    <Error Condition="'$(AstrBotRoot)' == ''"
           Text="AstrBotRoot must point to the exact checked-out AstrBot task root." />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <ProjectReference Include="$(AstrBotRoot)/src/AstrBot.DotNetHost/AstrBot.DotNetHost.csproj" />
  </ItemGroup>
</Project>
