{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.dev/schemas/modular-distribution-v01/release-pins-v1.schema.json",
  "title": "Cyrene modular distribution clean-host release pins",
  "description": "Expected official identities for one fresh-host acceptance run. Catalyst is required. Each workload separates direct roots in selectedComponents from dependency-only identities in dependencyComponents; the acceptance driver verifies both sets against the exact closure and reasons derived from the signed Catalog. A separate firstCoreBootstrap pin covers the signed C10 cohort without adding its non-overlapping Core rows to the ordinary Catalyst closure. The Core-phase maintenance hold contains C10 plus parent identities whose signed target artifactKind is native-binary, oci-image, python-bundle, or static-web; plugin-package archive identities remain in the ordinary parent plan and use their stage-derived package aggregate during the later package-only hold. The installed workload plan explicitly uses the signed preview channel; pins assert resolver identities and do not select or replace runtime authority. Optional standalone exact-match plugin pins enable an independent offline-stage retry when Catalyst staging is fully cache-backed. Optional Echo pins enable the separately gated installed OCI lifecycle and exact-match evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nativeInstaller", "catalog", "firstCoreBootstrap", "workloads"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "nativeInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "sourceRepository",
        "sourceRef",
        "sourceCommit",
        "workflow",
        "targetId",
        "debAssetName",
        "debSha256",
        "debSizeBytes"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^native-installer-preview-[0-9a-f]{40}$"
        },
        "sourceRepository": { "const": "DoHorizon-AI/Cyrene-Workspace" },
        "sourceRef": { "const": "refs/heads/develop" },
        "sourceCommit": { "$ref": "#/$defs/gitSha" },
        "workflow": {
          "const": "DoHorizon-AI/Cyrene-Workspace/.github/workflows/native-installer-release.yml"
        },
        "targetId": { "const": "linux-ubuntu-24.04-x86_64-python-3.12" },
        "debAssetName": {
          "type": "string",
          "pattern": "^cyrene_[A-Za-z0-9.+~:-]+_ubuntu-24\\.04_amd64\\.deb$"
        },
        "debSha256": { "$ref": "#/$defs/rawSha256" },
        "debSizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "repository",
        "workflow",
        "sourceRef",
        "sourceCommit",
        "assetName",
        "sha256",
        "sizeBytes",
        "attestationAssetName",
        "attestationSha256",
        "schemaVersion",
        "generation"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^catalog-v2-preview-[0-9a-f]{40}$"
        },
        "repository": { "const": "DoHorizon-AI/Cyrene-Workspace" },
        "workflow": {
          "const": "DoHorizon-AI/Cyrene-Workspace/.github/workflows/component-catalog-release.yml"
        },
        "sourceRef": { "const": "refs/heads/develop" },
        "sourceCommit": { "$ref": "#/$defs/gitSha" },
        "assetName": { "const": "component-catalog-v2.json" },
        "sha256": { "$ref": "#/$defs/rawSha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "attestationAssetName": { "const": "component-catalog-v2.json.attestation.jsonl" },
        "attestationSha256": { "$ref": "#/$defs/rawSha256" },
        "schemaVersion": { "const": 2 },
        "generation": { "type": "integer", "minimum": 1 }
      }
    },
    "firstCoreBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "cohortId", "catalogDigest", "targetId", "components"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "cohortId": { "const": "C10" },
        "catalogDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" },
        "components": {
          "description": "Exact six-member signed C10 first-Core cohort identities; the two identities shared with the Catalyst closure must match byte-for-byte.",
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/selectedComponent" },
          "allOf": [
            { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-linux-sys-adapter" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" } }, "required": ["componentId", "targetId"] } },
            { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-nvidia-adapter" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" } }, "required": ["componentId", "targetId"] } },
            { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-sandboxd" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" } }, "required": ["componentId", "targetId"] } },
            { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-runtime-maintenance" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" } }, "required": ["componentId", "targetId"] } },
            { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-kernel" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" } }, "required": ["componentId", "targetId"] } },
            { "contains": { "type": "object", "properties": { "componentId": { "const": "cy-package-runtime" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-systemd" } }, "required": ["componentId", "targetId"] } }
          ]
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalyst"],
      "properties": {
        "catalyst": {
          "allOf": [
            { "$ref": "#/$defs/workload" },
            {
              "type": "object",
              "required": ["service"],
              "properties": {
                "workloadId": { "const": "catalyst" },
                "selectedComponents": {
                  "minItems": 8,
                  "allOf": [
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-catalyst" } }, "required": ["componentId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-client-workspace-control" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-node-24" } }, "required": ["componentId", "targetId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-client-workspace-web" } }, "required": ["componentId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-runtime-maintenance-sdk" } }, "required": ["componentId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-tools-dataset-generation" } }, "required": ["componentId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-tools-dataset-preparation" } }, "required": ["componentId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-tools-document-parsing" } }, "required": ["componentId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-tools-knowledge-preparation" } }, "required": ["componentId"] } }
                  ]
                }
              }
            }
          ]
        },
        "plugins": {
          "allOf": [
            { "$ref": "#/$defs/workload" },
            {
              "type": "object",
              "not": { "required": ["service"] },
              "properties": {
                "workloadId": { "const": "plugins" },
                "selectedComponents": {
                  "minItems": 2,
                  "maxItems": 2,
                  "allOf": [
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-runtime-maintenance-sdk" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-python-3.12-library" } }, "required": ["componentId", "targetId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-evaluation-exact-match" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-python-3.12" } }, "required": ["componentId", "targetId"] } }
                  ]
                }
              },
              "required": ["workloadId", "selectedComponents"]
            }
          ]
        },
        "echo": {
          "description": "Optional exact signed Echo OCI, Runtime SDK, and exact-match identities for the installed lifecycle gate.",
          "allOf": [
            { "$ref": "#/$defs/workload" },
            {
              "type": "object",
              "not": { "required": ["service"] },
              "properties": {
                "workloadId": { "const": "echo" },
                "selectedComponents": {
                  "minItems": 3,
                  "allOf": [
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-echo" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-oci" }, "attestationRef": { "type": "object", "required": ["subjectName"] } }, "required": ["componentId", "targetId", "attestationRef"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-runtime-maintenance-sdk" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-python-3.12-library" } }, "required": ["componentId", "targetId"] } },
                    { "contains": { "type": "object", "properties": { "componentId": { "const": "cyrene-evaluation-exact-match" }, "targetId": { "const": "linux-ubuntu-24.04-x86_64-python-3.12" } }, "required": ["componentId", "targetId"] } }
                  ]
                }
              },
              "required": ["workloadId", "selectedComponents"]
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workloadId", "targetId", "catalogDigest", "channel", "selectedComponents", "dependencyComponents"],
      "properties": {
        "workloadId": { "enum": ["catalyst", "plugins", "echo"] },
        "targetId": { "const": "linux-ubuntu-24.04-x86_64" },
        "catalogDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "channel": { "const": "preview" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "baseUrl", "healthPath"],
          "properties": {
            "unit": { "const": "cyrene-catalyst.service" },
            "baseUrl": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$" },
            "healthPath": { "const": "/healthz" }
          }
        },
        "selectedComponents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selectedComponent" }
        },
        "dependencyComponents": {
          "description": "Exact official identities for components reached only through dependencies in the signed workload Catalog closure.",
          "type": "array",
          "items": { "$ref": "#/$defs/selectedComponent" }
        }
      }
    },
    "selectedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "targetId",
        "version",
        "releaseId",
        "manifestDigest",
        "manifestAssetDigest",
        "digest",
        "publisherIdentity",
        "indexIdentity",
        "attestationRef"
      ],
      "properties": {
        "componentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "targetId": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]{0,127}$"
        },
        "releaseId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "manifestAssetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "publisherIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "workflow"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "workflow": { "type": "string", "minLength": 1 },
            "tagFormat": { "type": "string", "minLength": 1 }
          }
        },
        "indexIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "assetName", "assetDigest", "indexDigest", "channel", "releaseTag"],
          "properties": {
            "publisherIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "workflow"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "repository": { "type": "string", "minLength": 1 },
                "workflow": { "type": "string", "minLength": 1 },
                "tagFormat": { "type": "string", "minLength": 1 }
              }
            },
            "repository": { "type": "string", "minLength": 1 },
            "assetName": { "const": "component-release-index-v1.json" },
            "assetUri": { "type": "string", "format": "uri", "minLength": 1 },
            "assetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "indexDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "channel": { "const": "preview" },
            "releaseTag": { "type": "string", "minLength": 1 }
          }
        },
        "attestationRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "workflow", "sourceCommit", "subjectDigest"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "workflow": { "type": "string", "minLength": 1 },
            "sourceCommit": { "$ref": "#/$defs/gitSha" },
            "sourceRef": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" },
            "subjectName": { "type": "string", "minLength": 1 },
            "subjectDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
