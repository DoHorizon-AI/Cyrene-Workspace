# syntax=docker/dockerfile:1.7
# Optional MXC namespace runner. The ordinary computer image remains managed.
# 可选的 MXC 命名空间执行器；普通电脑执行镜像仍使用 managed 后端。

ARG RUST_BASE_IMAGE=rust:1.96.1-slim-bookworm@sha256:e18a79fc84dfcfc3ab5ba72290398a644c135c97eaa881447fddc354ee4701a3
ARG RUNTIME_BASE_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
FROM ${RUST_BASE_IMAGE} AS build
ARG TARGETARCH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY Cyrene-Plugins-Official/contracts/proto ./contracts/proto
COPY Cyrene-Plugins-Official/contracts/rust/cyrene-plugin-contracts ./contracts/rust/cyrene-plugin-contracts
COPY Cyrene-Plugins-Official/runtime/rust ./runtime/rust
RUN --mount=type=cache,id=cyrene-mxc-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cyrene-mxc-build-${TARGETARCH},target=/build-target,sharing=locked \
    cargo build --locked --release --jobs 2 --target-dir /build-target --manifest-path runtime/rust/cyrene-plugin-server/Cargo.toml --features mxc --bin cyrene-plugin-server \
    && cargo build --locked --release --jobs 2 --target-dir /build-target --manifest-path runtime/rust/cyrene-computer-runtime/Cargo.toml --features mxc --bin cyrene-mxc-exec \
    && install -D --mode=0555 /build-target/release/cyrene-plugin-server /output/cyrene-plugin-server \
    && install -D --mode=0555 /build-target/release/cyrene-mxc-exec /output/cyrene-mxc-exec

FROM ${RUNTIME_BASE_IMAGE} AS bubblewrap-build
RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential pkg-config meson ninja-build libcap-dev xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
ADD --checksum=sha256:0e85c8702248b8dd64144f594147553650cdd0e4c951690345faace79c217c4d https://github.com/containers/bubblewrap/releases/download/v0.13.1/bubblewrap-0.13.1.tar.xz /source/bubblewrap-0.13.1.tar.xz
RUN tar --extract --xz --file bubblewrap-0.13.1.tar.xz \
    && meson setup build bubblewrap-0.13.1 --buildtype=release -Dman=disabled -Dtests=false -Dselinux=disabled -Dbash_completion=disabled -Dzsh_completion=disabled \
    && meson compile -C build \
    && install -D --mode=0555 build/bwrap /output/bwrap \
    && test "$(/output/bwrap --version)" = "bubblewrap 0.13.1"

FROM ${RUNTIME_BASE_IMAGE} AS runtime
ARG SOURCE_REPOSITORY=https://github.com/DoHorizon-AI/Cyrene-Plugins-Official
ARG SOURCE_REVISION

ENV CYRENE_COMPUTER_EXECUTION_BACKEND=mxc \
    CYRENE_COMPUTER_WORKSPACE_ROOT=/workspace \
    CYRENE_COMPUTER_ARTIFACT_ROOT=/var/lib/cyrene/artifacts \
    CYRENE_COMPUTER_COMMAND_DEFAULT_TIMEOUT_MS=30000 \
    CYRENE_COMPUTER_COMMAND_MAX_TIMEOUT_MS=600000 \
    CYRENE_COMPUTER_MAX_OUTPUT_BYTES=65536 \
    CYRENE_COMPUTER_MAX_FILE_BYTES=1048576 \
    CYRENE_COMPUTER_MAX_DIRECTORY_ENTRIES=2048 \
    CYRENE_COMPUTER_MAX_DIRECTORY_DEPTH=32 \
    CYRENE_COMPUTER_MAX_ARTIFACT_BYTES=16777216

RUN apt-get update \
    && apt-get install --yes --no-install-recommends bash ca-certificates libcap2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 cyrene \
    && useradd --system --uid 10001 --gid cyrene --create-home --home-dir /home/cyrene --shell /usr/sbin/nologin cyrene \
    && install -d --owner=10001 --group=10001 --mode=0750 /workspace /var/lib/cyrene/artifacts

COPY --from=build /output/cyrene-plugin-server /usr/local/bin/cyrene-plugin-server
COPY --from=build /output/cyrene-mxc-exec /usr/local/bin/cyrene-mxc-exec
COPY --from=bubblewrap-build /output/bwrap /usr/local/bin/bwrap
COPY --from=bubblewrap-build /source/bubblewrap-0.13.1/COPYING /usr/share/doc/cyrene/bubblewrap-COPYING
COPY --from=bubblewrap-build /source/bubblewrap-0.13.1.tar.xz /usr/share/doc/cyrene/bubblewrap-0.13.1.tar.xz
COPY Cyrene-Plugins-Official/THIRD_PARTY_NOTICES.md /usr/share/doc/cyrene/THIRD_PARTY_NOTICES.md
RUN chmod 0555 /usr/local/bin/cyrene-plugin-server /usr/local/bin/cyrene-mxc-exec /usr/local/bin/bwrap

LABEL org.opencontainers.image.source=${SOURCE_REPOSITORY} \
    org.opencontainers.image.revision=${SOURCE_REVISION} \
    com.cyrene.computer.execution-backend=mxc \
    com.cyrene.computer.mxc-sdk-version=1.0.1 \
    com.cyrene.computer.bubblewrap-version=0.13.1
USER 10001:10001
EXPOSE 50051
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
    CMD ["/usr/local/bin/cyrene-plugin-server", "--health-check", "--host", "127.0.0.1", "--port", "50051"]
ENTRYPOINT ["/usr/local/bin/cyrene-plugin-server"]
CMD ["--host", "0.0.0.0", "--port", "50051"]
