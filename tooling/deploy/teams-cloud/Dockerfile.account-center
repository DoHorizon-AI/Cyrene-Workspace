# syntax=docker/dockerfile:1.7

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CYRENE_PLUGIN_STORAGE_PATH=/data \
    PYTHONPATH=/app/Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src:/app/Cyrene-Plugins-Official/sdk/python/cyrene_account_center_contracts/src:/app/Cyrene-Plugins-Official/plugins/accounts/account-center/src
RUN groupadd --system --gid 10001 accountcenter \
    && useradd --system --uid 10001 --gid accountcenter --no-create-home --shell /usr/sbin/nologin accountcenter \
    && install -d --owner=10001 --group=10001 --mode=0700 /data /app

WORKDIR /app
COPY Cyrene-Plugins-Official/plugins/accounts/account-center/requirements.lock /tmp/account-center-requirements.lock
COPY Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src /app/Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src
COPY Cyrene-Plugins-Official/sdk/python/cyrene_account_center_contracts/src /app/Cyrene-Plugins-Official/sdk/python/cyrene_account_center_contracts/src
COPY Cyrene-Plugins-Official/plugins/accounts/account-center/src /app/Cyrene-Plugins-Official/plugins/accounts/account-center/src
COPY Cyrene-Plugins-Official/plugins/accounts/account-center/plugin.manifest.json /app/Cyrene-Plugins-Official/plugins/accounts/account-center/
RUN python -m pip install --no-cache-dir -r /tmp/account-center-requirements.lock
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/secret-env-entrypoint.sh /usr/local/bin/cyrene-secret-env-entrypoint
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/plugin_grpc_health_probe.py /usr/local/bin/cyrene-plugin-grpc-health
RUN chmod 0555 /usr/local/bin/cyrene-secret-env-entrypoint /usr/local/bin/cyrene-plugin-grpc-health

LABEL org.opencontainers.image.source=https://github.com/DoHorizon-AI/Cyrene-Plugins-Official
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
USER 10001:10001
EXPOSE 7443
ENTRYPOINT ["/usr/local/bin/cyrene-secret-env-entrypoint", "python", "-m", "cyrene_plugin_runtime.server"]
CMD ["--entrypoint", "account_center.plugin:AccountCenterPlugin", "--capability", "account.center.v1", "--interface-version", "1", "--listen", "account-center:7443", "--tls-cert-file", "/run/secrets/account-center-server-cert", "--tls-key-file", "/run/secrets/account-center-server-key", "--tls-client-ca-file", "/run/secrets/account-center-client-ca"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
    CMD python /usr/local/bin/cyrene-plugin-grpc-health --target account-center:7443 \
      --plugin-id cyrene.accounts.account-center \
      --server-ca /run/secrets/account-center-server-root-ca \
      --client-cert /run/secrets/account-center-health-client-cert \
      --client-key /run/secrets/account-center-health-client-key
