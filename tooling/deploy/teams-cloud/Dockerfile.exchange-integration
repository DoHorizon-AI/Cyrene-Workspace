# syntax=docker/dockerfile:1.7

ARG UV_BASE_IMAGE
ARG PYTHON_BASE_IMAGE
FROM ${UV_BASE_IMAGE} AS uv-source

FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV UV_PROJECT_ENVIRONMENT=/app/Cyrene-Services/Cyrene-Exchange/product/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CYRENE_EXCHANGE_RUNTIME_MODE=integration-only

COPY --from=uv-source /uv /uvx /usr/local/bin/
RUN groupadd --system --gid 10001 exchange \
    && useradd --system --uid 10001 --gid exchange --no-create-home --shell /usr/sbin/nologin exchange \
    && install -d --owner=10001 --group=10001 --mode=0750 /data

WORKDIR /app
COPY Cyrene-Services/Cyrene-Exchange ./Cyrene-Services/Cyrene-Exchange
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && uv sync --frozen --no-dev --extra integrations \
        --project /app/Cyrene-Services/Cyrene-Exchange/product \
    && apt-get purge --yes --auto-remove git \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/secret-env-entrypoint.sh /usr/local/bin/cyrene-secret-env-entrypoint
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/office_oauth_setup.py /app/office_oauth_setup.py
RUN chmod 0555 /usr/local/bin/cyrene-secret-env-entrypoint

USER 10001:10001
EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=3 \
    CMD /app/Cyrene-Services/Cyrene-Exchange/product/.venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/readyz', timeout=3)"
ENTRYPOINT ["/usr/local/bin/cyrene-secret-env-entrypoint", "/app/Cyrene-Services/Cyrene-Exchange/product/.venv/bin/cyrene-exchange"]
CMD ["serve", "--mode", "integration-only", "--integration-database", "/data/integrations.sqlite3", "--host", "0.0.0.0", "--port", "8081"]
