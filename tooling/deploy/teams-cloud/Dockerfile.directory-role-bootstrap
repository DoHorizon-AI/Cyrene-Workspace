# syntax=docker/dockerfile:1.7

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --system --gid 10001 directorybootstrap \
    && useradd --system --uid 10001 --gid directorybootstrap --no-create-home --shell /usr/sbin/nologin directorybootstrap \
    && install -d --owner=10001 --group=10001 --mode=0750 /app
WORKDIR /app
COPY Cyrene-Workspace/tooling/deploy/teams-cloud/directory-bootstrap-requirements.lock /app/requirements.lock
RUN python -m pip install --no-cache-dir -r /app/requirements.lock
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/directory-role-bootstrap.py /app/directory-role-bootstrap.py
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source=https://github.com/DoHorizon-AI/Cyrene-Workspace \
      org.opencontainers.image.revision=${SOURCE_REVISION}
USER 10001:10001
ENTRYPOINT ["python", "/app/directory-role-bootstrap.py"]
