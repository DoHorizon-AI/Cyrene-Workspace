# syntax=docker/dockerfile:1.7

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PYTHONPATH=/app/Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src:/app/Cyrene-Plugins-Official/sdk/python/cyrene_account_center_contracts/src:/app/Cyrene-Plugins-Official/plugins/providers/huggingface/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 huggingfaceprovider \
    && useradd --system --uid 10001 --gid huggingfaceprovider --no-create-home --shell /usr/sbin/nologin huggingfaceprovider \
    && install -d --owner=10001 --group=10001 --mode=0750 /app

WORKDIR /app/Cyrene-Plugins-Official
COPY Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src ./sdk/python/cyrene_plugin_runtime/src
COPY Cyrene-Plugins-Official/sdk/python/cyrene_account_center_contracts/src ./sdk/python/cyrene_account_center_contracts/src
COPY Cyrene-Workspace/tooling/deploy/teams-cloud/config/requirements.huggingface-cli.lock /tmp/huggingface-runtime.lock
COPY Cyrene-Plugins-Official/plugins/providers/huggingface/pyproject.toml \
     Cyrene-Plugins-Official/plugins/providers/huggingface/README.md \
     Cyrene-Plugins-Official/plugins/providers/huggingface/plugin.manifest.json \
     Cyrene-Plugins-Official/plugins/providers/huggingface/configuration.schema.json \
     ./plugins/providers/huggingface/
COPY Cyrene-Plugins-Official/plugins/providers/huggingface/src ./plugins/providers/huggingface/src
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/huggingface-runtime.lock \
    && python -c "import huggingface_hub; assert huggingface_hub.__version__ == '2.2.0'" \
    && test -x /usr/local/bin/hf \
    && /usr/local/bin/hf --help >/dev/null

COPY Cyrene-Workspace/tooling/deploy/teams-cloud/secret-env-entrypoint.sh /usr/local/bin/cyrene-secret-env-entrypoint
COPY Cyrene-Workspace/tooling/deploy/teams-cloud/plugin_grpc_health_probe.py /usr/local/bin/cyrene-plugin-grpc-health
RUN chmod 0555 /usr/local/bin/cyrene-secret-env-entrypoint /usr/local/bin/cyrene-plugin-grpc-health

ARG SOURCE_REVISION
LABEL org.opencontainers.image.source=https://github.com/DoHorizon-AI/Cyrene-Plugins-Official \
      org.opencontainers.image.revision=${SOURCE_REVISION}
USER 10001:10001
EXPOSE 7443
ENTRYPOINT ["/usr/local/bin/cyrene-secret-env-entrypoint", "python", "-m", "cyrene_plugin_runtime.server"]
CMD ["--entrypoint", "huggingface_provider.plugin:HuggingFaceProvider", "--capability", "tool.provider.v1", "--interface-version", "1", "--listen", "0.0.0.0:7443", "--tls-cert-file", "/run/secrets/huggingface-server-cert", "--tls-key-file", "/run/secrets/huggingface-server-key", "--tls-client-ca-file", "/run/secrets/huggingface-client-ca"]
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
      CMD python /usr/local/bin/cyrene-plugin-grpc-health \
      --target huggingface:7443 --plugin-id cyrene.providers.huggingface \
      --server-ca /run/secrets/huggingface-health-server-ca \
      --client-cert /run/secrets/huggingface-health-client-cert \
      --client-key /run/secrets/huggingface-health-client-key
