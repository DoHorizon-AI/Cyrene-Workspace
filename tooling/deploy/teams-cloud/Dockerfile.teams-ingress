# syntax=docker/dockerfile:1.7

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=3978 \
    HOST=0.0.0.0 \
    PYTHONPATH=/app/Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src:/app/Cyrene-Plugins-Official/plugins/connectors/teams/src
RUN groupadd --system --gid 10001 teams \
    && useradd --system --uid 10001 --gid teams --no-create-home --shell /usr/sbin/nologin teams \
    && install -d --owner=10001 --group=10001 --mode=0750 /app

WORKDIR /app/Cyrene-Plugins-Official
COPY Cyrene-Plugins-Official/sdk/python/cyrene_plugin_runtime/src ./sdk/python/cyrene_plugin_runtime/src
COPY Cyrene-Plugins-Official/plugins/connectors/teams/pyproject.toml \
     Cyrene-Plugins-Official/plugins/connectors/teams/requirements.lock \
     Cyrene-Plugins-Official/plugins/connectors/teams/README.md \
     Cyrene-Plugins-Official/plugins/connectors/teams/plugin.manifest.json \
     Cyrene-Plugins-Official/plugins/connectors/teams/configuration.schema.json \
     ./plugins/connectors/teams/
COPY Cyrene-Plugins-Official/plugins/connectors/teams/src ./plugins/connectors/teams/src
RUN python -m pip install --no-cache-dir -r /app/Cyrene-Plugins-Official/plugins/connectors/teams/requirements.lock
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/secret-env-entrypoint.sh /usr/local/bin/cyrene-secret-env-entrypoint
COPY --chown=10001:10001 Cyrene-Workspace/tooling/deploy/teams-cloud/plugin_grpc_health_probe.py /usr/local/bin/cyrene-plugin-grpc-health
RUN chmod 0555 /usr/local/bin/cyrene-secret-env-entrypoint /usr/local/bin/cyrene-plugin-grpc-health

USER 10001:10001
EXPOSE 3978
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3978/health/ready', timeout=3)"
ENTRYPOINT ["/usr/local/bin/cyrene-secret-env-entrypoint", "python", "-m", "teams_connector.ingress"]
