{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/teams-credential-notifications-v1.schema.json",
  "title": "Private owner-scoped Teams credential-health notification projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "organizationId",
    "workspaceId",
    "owner",
    "connections",
    "destination",
    "exchange"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "organizationId": {"type": "string", "format": "uuid"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorAadObjectId", "issuer", "subject", "tenantId"],
      "properties": {
        "actorAadObjectId": {"type": "string", "format": "uuid"},
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://login\\.microsoftonline\\.com/[^/]+/v2\\.0$"
        },
        "subject": {"type": "string", "format": "uuid"},
        "tenantId": {"type": "string", "format": "uuid"}
      }
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectionId", "provider"],
        "properties": {
          "connectionId": {"type": "string", "format": "uuid"},
          "provider": {"enum": ["hf", "azure", "gcp", "runpod"]}
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "teamId",
        "channelId",
        "conversationId",
        "rootThreadId",
        "serviceUrl"
      ],
      "properties": {
        "tenantId": {"type": "string", "format": "uuid"},
        "teamId": {"type": "string", "minLength": 1, "maxLength": 256},
        "channelId": {"type": "string", "minLength": 1, "maxLength": 256},
        "conversationId": {"type": "string", "minLength": 1, "maxLength": 512},
        "rootThreadId": {"type": "string", "minLength": 1, "maxLength": 256},
        "serviceUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRef"],
      "properties": {
        "profileRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "pollIntervalMs": {"type": "integer", "minimum": 60000, "maximum": 3600000}
  }
}
