# Load after runtime.env only when explicitly selecting the native Google ACP profile.
# This file contains non-secret selectors; owner-only OAuth state stays in secrets/antigravity-acp.
# 中文：仅在显式选择 Google 原生 ACP profile 时加载。本文件不含密钥；owner-only OAuth 状态保存在 secrets/antigravity-acp。

CYRENE_HARNESS_EXECUTION_BACKEND=antigravity-acp
CYRENE_HARNESS_ANTIGRAVITY_ACP_COMMAND=/usr/local/bin/agy_acp_server.par
CYRENE_HARNESS_ANTIGRAVITY_ACP_PROFILE=/home/navigator/.config/antigravity-acp
# The current authenticated owner inventory advertises this ID; Navigator verifies it per session.
# 当前已验证的 owner 模型目录包含此 ID；Navigator 会在每个 session 中重新核验。
CYRENE_HARNESS_ANTIGRAVITY_ACP_MODEL=gemini-3.8-flash
CYRENE_HARNESS_MODEL_SOURCE=
CYRENE_HARNESS_MODEL=
CYRENE_EXECUTOR_MAX_CONCURRENT_TASKS=2
CYRENE_WORKFLOWS_ENABLED=false
CYRENE_RESPONSIBILITY_TARGETS_HOST_FILE=${CYRENE_ARTIFACTS_DIR}/config/responsibility-targets.v1.json
CYRENE_HF_ENABLED=false
