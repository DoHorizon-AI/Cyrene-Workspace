{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/teams-runtime-health-policy-v2.schema.json",
  "title": "Versioned Cyrene runtime health observation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedServiceCount", "expectedTotals", "schedule", "hostGates"],
  "properties": {
    "schemaVersion": {"const": 2},
    "expectedServiceCount": {"type": "integer", "enum": [14, 15, 16]},
    "expectedTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryBytes", "nanoCpus"],
      "properties": {
        "memoryBytes": {"type": "integer", "minimum": 1, "maximum": 3758096384},
        "nanoCpus": {"type": "integer", "minimum": 1, "maximum": 1950000000}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalSeconds", "durationSeconds", "expectedSamples", "maxScheduleLagSeconds"],
      "properties": {
        "intervalSeconds": {"const": 60},
        "durationSeconds": {"const": 86400},
        "expectedSamples": {"const": 1441},
        "maxScheduleLagSeconds": {"const": 5}
      }
    },
    "hostGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minMemAvailableBytes", "minRootDiskAvailableBytes"],
      "properties": {
        "minMemAvailableBytes": {"type": "integer", "minimum": 1073741824},
        "minRootDiskAvailableBytes": {"type": "integer", "minimum": 2147483648}
      }
    }
  }
}
