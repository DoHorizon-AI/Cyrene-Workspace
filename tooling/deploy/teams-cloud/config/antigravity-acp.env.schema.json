{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/antigravity-acp-env-v1.schema.json",
  "title": "Cyrene native Antigravity ACP profile environment",
  "description": "Non-secret selectors for the opt-in Google ACP runtime. Authentication stays in the mounted owner-only profile. / Google ACP 可选运行时的非敏感选择项；授权数据保存在挂载的 owner-only profile 中。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CYRENE_HARNESS_EXECUTION_BACKEND",
    "CYRENE_HARNESS_ANTIGRAVITY_ACP_COMMAND",
    "CYRENE_HARNESS_ANTIGRAVITY_ACP_PROFILE",
    "CYRENE_HARNESS_MODEL_SOURCE",
    "CYRENE_HARNESS_MODEL",
    "CYRENE_EXECUTOR_MAX_CONCURRENT_TASKS",
    "CYRENE_WORKFLOWS_ENABLED",
    "CYRENE_RESPONSIBILITY_TARGETS_HOST_FILE",
    "CYRENE_HF_ENABLED"
  ],
  "properties": {
    "CYRENE_HARNESS_EXECUTION_BACKEND": {"const": "antigravity-acp"},
    "CYRENE_HARNESS_ANTIGRAVITY_ACP_COMMAND": {"const": "/usr/local/bin/agy_acp_server.par"},
    "CYRENE_HARNESS_ANTIGRAVITY_ACP_PROFILE": {"const": "/home/navigator/.config/antigravity-acp"},
    "CYRENE_HARNESS_ANTIGRAVITY_ACP_MODEL": {
      "description": "Exact model ID advertised by the authorized native ACP profile; empty selects its native default. / 已授权 ACP profile 公布的确切模型 ID；留空使用其原生默认值。",
      "anyOf": [
        {"const": ""},
        {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$"}
      ]
    },
    "CYRENE_HARNESS_MODEL_SOURCE": {"const": ""},
    "CYRENE_HARNESS_MODEL": {"const": ""},
    "CYRENE_EXECUTOR_MAX_CONCURRENT_TASKS": {"const": "2"},
    "CYRENE_WORKFLOWS_ENABLED": {"const": "false"},
    "CYRENE_RESPONSIBILITY_TARGETS_HOST_FILE": {
      "const": "${CYRENE_ARTIFACTS_DIR}/config/responsibility-targets.v1.json"
    },
    "CYRENE_HF_ENABLED": {"const": "false"}
  }
}
