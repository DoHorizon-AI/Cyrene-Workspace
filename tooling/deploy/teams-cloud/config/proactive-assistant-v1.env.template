# Copy to the task's private .artifacts directory and load after runtime.env.
# This file contains non-secret defaults; CLI credentials stay in MODEL_HOME.
# 中文：复制到任务私有 .artifacts 并在 runtime.env 后加载。本文件只放非敏感默认值；CLI 凭据保存在 MODEL_HOME。

CYRENE_MODEL_HOME=${CYRENE_ARTIFACTS_DIR}/model-home
CYRENE_RESPONSIBILITY_TARGETS_HOST_FILE=${CYRENE_ARTIFACTS_DIR}/config/responsibility-targets.v1.json
CYRENE_HARNESS_MODEL_SOURCE=antigravity
CYRENE_HARNESS_MODEL=gemini-3.8-flash-medium
CYRENE_HARNESS_CODEBUDDY_FALLBACK_ENABLED=true
CYRENE_HARNESS_CODEBUDDY_NO_PAID_TOPUP=true
CYRENE_HARNESS_CODEBUDDY_FALLBACK_MODEL=glm-5.3-flash
CYRENE_EXECUTOR_MAX_CONCURRENT_TASKS=2
