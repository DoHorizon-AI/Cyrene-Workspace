# Copy to the private artifacts directory and fill only non-secret configuration.
# Keep this file outside Git; secret values belong in separate 0400 files.

CYRENE_ARTIFACTS_DIR=/absolute/path/to/Cyrene/.artifacts/teams-cloud-20261023
CYRENE_CONFIG_DIR=${CYRENE_ARTIFACTS_DIR}/config
CYRENE_SECRETS_DIR=${CYRENE_ARTIFACTS_DIR}/secrets
CYRENE_CLOUD_ACCEPTANCE_DIR=${CYRENE_ARTIFACTS_DIR}/acceptance/cloud-resources
CYRENE_CODEBUDDY_HOME=${CYRENE_SECRETS_DIR}/codebuddy
CYRENE_HF_OAUTH_BOOTSTRAP_FILE=${CYRENE_ARTIFACTS_DIR}/onboarding/private/huggingface-oauth.json

TEAMS_FQDN=teams.example.invalid
CYRENE_CADDYFILE=./Caddyfile.staging
TEAMS_ALLOWED_TEAM_IDS=REPLACE_WITH_TEAM_ID
TEAMS_BOT_APP_ID=REPLACE_WITH_TEAMS_BOT_APP_ID
TEAMS_TENANT_ID=REPLACE_WITH_TENANT_ID
CYRENE_HARNESS_MODEL_SOURCE=codebuddy
CYRENE_HARNESS_MODEL=glm-5.3-flash

CYRENE_ACCOUNT_CENTER_CONFIGURATION_JSON={}
CYRENE_ACCOUNT_CENTER_BINDING_ID=REPLACE_WITH_ACCOUNT_CENTER_BINDING_ID
CYRENE_EXCHANGE_INTEGRATION_CONFIGURATION_JSON={}
CYRENE_EXCHANGE_INTEGRATION_CONFIGURATION_PHASE2_JSON={}
CYRENE_EXCHANGE_INTEGRATION_CONFIGURATION_PHASE3_JSON={}
CYRENE_CLOUD_MANAGEMENT_PHASE2_CONFIGURATION_JSON={}
CYRENE_CLOUD_MANAGEMENT_PHASE3_CONFIGURATION_JSON={}
CYRENE_GITHUB_ISSUES_BINDING_ID=REPLACE_WITH_GITHUB_BINDING_ID
CYRENE_GITHUB_ISSUES_CONFIGURATION_JSON={}
CYRENE_HUGGINGFACE_BINDING_ID=REPLACE_WITH_HUGGINGFACE_BINDING_ID
CYRENE_HUGGINGFACE_CONFIGURATION_JSON={}
CYRENE_TEAMS_CONNECTOR_BINDING_ID=host-teams-message-binding
# Use the compact, one-line JSON from config/teams-connector.template.json.
CYRENE_TEAMS_CONNECTOR_CONFIGURATION_JSON={}

# Staging binds to loopback on a high port. Cutover uses the VM public NIC address and TCP 443.
CYRENE_PUBLIC_BIND=127.0.0.1
CYRENE_HTTPS_PORT=18443

# Directory and authority values are public identity/configuration references, never private keys.
CYRENE_AUTHORITY_AAD_TENANT_ID=REPLACE_WITH_TENANT_ID
CYRENE_AUTHORITY_SIGNING_KEY_ID=REPLACE_WITH_SIGNING_KEY_ID
CYRENE_AUTHORITY_EXCHANGE_WORKLOAD_ID=REPLACE_WITH_EXCHANGE_WORKLOAD_ID
CYRENE_AUTHORITY_EXCHANGE_MTLS_SHA256=REPLACE_WITH_EXCHANGE_CLIENT_CERT_SHA256
CYRENE_AUTHORITY_EXCHANGE_WORKLOAD_AUDIENCE=exchange
CYRENE_NAVIGATOR_EXCHANGE_HMAC_KEY_ID=navigator-v1
CYRENE_TEAMS_NAVIGATOR_HMAC_KEY_ID=teams-v1
CYRENE_ORGANIZATION_ID=REPLACE_WITH_DIRECTORY_ORGANIZATION_ID
CYRENE_WORKSPACE_ID=REPLACE_WITH_DIRECTORY_WORKSPACE_ID
CYRENE_DIRECTORY_OPERATOR_ACTOR_ID=REPLACE_WITH_DIRECTORY_OPERATOR_ACTOR_ID
CYRENE_TEAMS_EXCHANGE_CONNECTION_REF=REPLACE_WITH_EXCHANGE_TEAMS_CONNECTION_REF
CYRENE_TEAMS_EXCHANGE_PROFILE_REF=REPLACE_WITH_EXCHANGE_TEAMS_PROFILE_REF

# Cloud profiles are generated from the private source after organization, subscription,
# project, and owner identities are verified. Phase 3 config adds only the RunPod profile.
CYRENE_CLOUD_MANAGEMENT_BINDING_ID=REPLACE_WITH_BINDING_ID
CYRENE_CLOUD_MANAGEMENT_STATE_DIR=/var/lib/cyrene/cloud-management
CYRENE_AZURE_USER_ASSIGNED_IDENTITY_CLIENT_ID=REPLACE_WITH_DEDICATED_UAMI_CLIENT_ID
CYRENE_AZURE_SUBSCRIPTION_ID=REPLACE_WITH_APPROVED_AZURE_SUBSCRIPTION_ID
