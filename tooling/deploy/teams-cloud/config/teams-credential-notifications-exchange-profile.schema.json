{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/teams-credential-notifications-exchange-profile-v1.schema.json",
  "title": "Private fixed-route Teams credential-health Exchange profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["systemNotification"],
  "properties": {
    "systemNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileRef", "ownerSubject", "fixedRoute"],
      "properties": {
        "profileRef": {"type": "string", "minLength": 1, "maxLength": 128},
        "ownerSubject": {"type": "string", "format": "uuid"},
        "fixedRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenantId",
            "teamId",
            "channelId",
            "conversationId",
            "rootThreadId",
            "serviceUrl"
          ],
          "properties": {
            "tenantId": {"type": "string", "format": "uuid"},
            "teamId": {"type": "string", "minLength": 1, "maxLength": 256},
            "channelId": {"type": "string", "minLength": 1, "maxLength": 256},
            "conversationId": {"type": "string", "minLength": 1, "maxLength": 512},
            "rootThreadId": {"type": "string", "minLength": 1, "maxLength": 256},
            "serviceUrl": {
              "type": "string",
              "minLength": 8,
              "maxLength": 2048,
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
