{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/teams-cloud-tool-catalog-v1.schema.json",
  "title": "Exchange-exported provider tool catalog for Navigator",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bindingId", "capabilityId", "providerId", "connectionRef", "profileRef", "tools"],
        "properties": {
          "bindingId": {"type": "string", "minLength": 1},
          "capabilityId": {"const": "tool.provider.v1"},
          "providerId": {"enum": ["github", "huggingface", "azure", "gcp", "runpod", "computer"]},
          "connectionRef": {"type": "string", "format": "uuid"},
          "profileRef": {"type": "string", "minLength": 1},
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "description", "readOnly", "inputSchema"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "readOnly": {"type": "boolean"},
                "inputSchema": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
