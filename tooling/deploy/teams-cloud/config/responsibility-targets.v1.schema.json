{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/responsibility-targets-v1.schema.json",
  "title": "Navigator host-owned responsibility repository targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "bindingId", "uri", "actionGrants"],
        "properties": {
          "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "label": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "bindingId": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
          "actionGrants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "action", "baseBranches", "branchPrefixes", "pathPrefixes", "issueNumbers", "sourceWorkflowIds", "permittedOperations"],
              "properties": {
                "id": {"type": "string", "enum": ["draft_pull_request", "rerun_source_ci", "update_issue_progress"]},
                "action": {"type": "string", "enum": ["draft_pull_request", "rerun_source_ci", "update_issue_progress"]},
                "baseBranches": {"type": "array", "items": {"type": "string"}},
                "branchPrefixes": {"type": "array", "items": {"type": "string"}},
                "pathPrefixes": {"type": "array", "items": {"type": "string"}},
                "issueNumbers": {"type": "array", "items": {"type": "integer", "minimum": 1}},
                "sourceWorkflowIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}
                },
                "permittedOperations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "github.branch.create",
                      "github.file.commit",
                      "github.pull_request.draft.create",
                      "github.actions.rerun_failed",
                      "github.issue.comment.create",
                      "github.issue.state.update"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
