{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.invalid/schemas/teams-cloud-acceptance-plan-v1.schema.json",
  "title": "Cyrene bounded cloud acceptance plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "budgetUsd", "stage", "owner", "resources"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "cyrene-cloud-acceptance-plan-v1"},
    "taskId": {"type": "string", "minLength": 3, "maxLength": 44, "pattern": "^[a-z][a-z0-9-]{2,43}$"},
    "budgetUsd": {"const": 5.0},
    "stage": {"enum": ["azure_gcp", "runpod"]},
    "owner": {"type": "string", "minLength": 1, "maxLength": 256},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "argvAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeoutSeconds"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900}
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeoutSeconds", "itemsPointer", "markerPointer", "markerValue"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "itemsPointer": {"type": "string"},
        "markerPointer": {"type": "string", "pattern": "^/"},
        "markerValue": {"type": "string", "minLength": 1},
        "markerInArgv": {"type": "boolean", "default": true},
        "referencePointer": {"type": "string", "pattern": "^/"},
        "expectedPointer": {"type": "string", "pattern": "^/"},
        "expectedValue": {"type": ["string", "number", "boolean"]}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "action", "readback"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
        "action": {"$ref": "#/$defs/argvAction"},
        "readback": {"$ref": "#/$defs/readback"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "maxLifetimeSeconds", "ownership", "pricing", "create", "readback", "exercise", "cleanup", "cleanupReadback"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 81, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
        "provider": {"enum": ["azure", "gcp", "runpod"]},
        "maxLifetimeSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskId", "owner", "marker"],
          "properties": {
            "taskId": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "marker": {"type": "string", "minLength": 1, "maxLength": 180}
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "upperBoundUsd", "quoteRef", "quotedAt"],
          "properties": {
            "currency": {"const": "USD"},
            "upperBoundUsd": {"type": "number", "minimum": 0, "maximum": 5},
            "quoteRef": {"type": "string", "format": "uri", "pattern": "^https://"},
            "quotedAt": {"type": "string", "format": "date-time"}
          }
        },
        "create": {"$ref": "#/$defs/argvAction"},
        "readback": {"$ref": "#/$defs/readback"},
        "exercise": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exercise"}},
        "cleanup": {"$ref": "#/$defs/argvAction"},
        "cleanupReadback": {"$ref": "#/$defs/readback"}
      }
    }
  }
}
