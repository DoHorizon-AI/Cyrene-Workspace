# Load after runtime.env when explicitly composing the CodeBuddy ACP profile.
# This file contains non-secret selectors; the owner-only login stays in CYRENE_CODEBUDDY_HOME.
# 中文：显式启用 CodeBuddy ACP profile 时在 runtime.env 后加载。本文件只存非敏感选择项；owner-only 登录保存在 CYRENE_CODEBUDDY_HOME。

CYRENE_HARNESS_EXECUTION_BACKEND=codebuddy-acp
CYRENE_HARNESS_CODEBUDDY_ACP_COMMAND=codebuddy
CYRENE_HARNESS_CODEBUDDY_ACP_MODEL=glm-5.3-flash
CYRENE_HARNESS_MODEL_SOURCE=
CYRENE_HARNESS_MODEL=
CYRENE_HARNESS_CODEBUDDY_FALLBACK_ENABLED=false
CYRENE_HARNESS_CODEBUDDY_NO_PAID_TOPUP=true
CYRENE_HARNESS_CODEBUDDY_FALLBACK_MODEL=
CYRENE_RESPONSIBILITY_TARGETS_HOST_FILE=${CYRENE_ARTIFACTS_DIR}/config/responsibility-targets.v1.json
